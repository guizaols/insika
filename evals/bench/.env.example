# Copy to .env (gitignored). The key never enters an image and never enters a report.
OPENROUTER_API_KEY=
# One model, identical for every entrant. Recorded in the report with its price.
BENCH_MODEL=
# Optional: turns the token column into a cost column. Date it — prices move.
BENCH_PRICE_PER_MTOK=
BENCH_PRICE_NOTE=
