#!/usr/bin/env node
// OpenCode's translation of "a turn". `opencode run --format json` is one message in
// and a stream of JSON events out; the last text part is the answer. The session id
// OpenCode mints on turn one is written to a marker file, so turn two continues the
// same conversation with --session instead of starting over.
//
// Scorecard A points it at /etc/bench/opencode-a.json — the store's ten tools and
// nothing else. Scorecard B points it at opencode-b.json, the same binary with its
// own bash/read/write/task surface left on, which is what it ships with.
//
// Tool calls come from the STORE's log, like every entrant: it is the only source
// that is not a harness reporting on itself.
const { spawnSync } = require("node:child_process");
const { readFileSync, writeFileSync, existsSync, mkdirSync } = require("node:fs");

const STORE = (process.env.BENCH_STORE_MCP || "").replace(/\/mcp$/, "");
const SCORECARD = (process.env.BENCH_SCORECARD || "A").toUpperCase();
const MARKERS = "/tmp/bench-sessions";
const input = JSON.parse(readFileSync(0, "utf8"));

async function calls(since) {
  const res = await fetch(`${STORE}/admin/calls?since=${since}`);
  return res.json();
}

(async () => {
  const answer = { output_text: "", tool_calls: [], error: null, usage: null };
  let mark = 0;
  try {
    mark = (await calls(0)).count;
  } catch (e) {
    answer.error = `store call log unreachable: ${e.message}`;
    process.stdout.write(JSON.stringify(answer) + "\n");
    return;
  }

  mkdirSync(MARKERS, { recursive: true });
  const marker = `${MARKERS}/${input.conv.replace(/\//g, "_")}`;
  const resume = existsSync(marker) ? ["--session", readFileSync(marker, "utf8").trim()] : [];

  const run = spawnSync("opencode", [
    "run", input.message,
    "--format", "json",
    "--agent", "bench",
    "--model", `openrouter/${process.env.BENCH_MODEL || "deepseek/deepseek-v4-flash"}`,
    // Same reasoning effort as every other entrant.
    "--variant", process.env.BENCH_REASONING || "medium",
    ...resume
  ], {
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
    cwd: "/work",
    env: { ...process.env, OPENCODE_CONFIG: `/etc/bench/opencode-${SCORECARD.toLowerCase()}.json` }
  });

  // NDJSON: `text` parts are what the customer sees, `step_finish` carries the
  // tokens for the step. A turn is several steps, so the tokens are summed — the
  // context OpenCode re-sends on each step is billed on each step.
  let session = null;
  const texts = [];
  const usage = { input_tokens: 0, output_tokens: 0, total_tokens: 0 };
  for (const line of (run.stdout || "").split("\n")) {
    if (!line.startsWith("{")) continue;
    let event;
    try { event = JSON.parse(line); } catch { continue; }
    if (event.sessionID) session = event.sessionID;
    if (event.type === "text" && event.part?.text?.trim()) texts.push(event.part.text.trim());
    if (event.type === "step_finish") {
      const t = event.part?.tokens || {};
      usage.input_tokens += t.input || 0;
      usage.output_tokens += (t.output || 0) + (t.reasoning || 0);
      // OpenCode's own `total` also folds in cache reads; the other entrants report
      // fresh input + output, so this column is summed the same way or the cost
      // comparison is between two different meanings of "token".
      usage.total_tokens += (t.input || 0) + (t.output || 0) + (t.reasoning || 0);
    }
  }
  if (session) writeFileSync(marker, session);
  answer.output_text = texts[texts.length - 1] || "";
  if (usage.total_tokens) answer.usage = usage;
  if (!answer.output_text) {
    answer.error = `opencode exited ${run.status} with no answer: ` +
                   (run.stderr || "").trim().split("\n").slice(-2).join(" ").slice(0, 300);
  }

  try {
    const log = await calls(mark);
    answer.tool_calls = log.calls.map((c) => ({ name: c.name.replace(/^store__/, ""), status: c.status }));
  } catch (e) {
    answer.error ||= `store call log unreachable after the turn: ${e.message}`;
  }

  process.stdout.write(JSON.stringify(answer) + "\n");
})();
