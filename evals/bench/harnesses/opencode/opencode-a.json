{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "store": { "type": "remote", "url": "{env:BENCH_STORE_MCP}", "enabled": true }
  },
  "permission": { "bash": "deny", "edit": "deny", "webfetch": "deny" },
  "agent": {
    "bench": {
      "mode": "primary",
      "description": "The bench turn: a store attendant with the store's ten tools.",
      "tools": {
        "bash": false, "edit": false, "write": false, "read": false, "grep": false,
        "glob": false, "list": false, "patch": false, "webfetch": false,
        "task": false, "todowrite": false, "todoread": false,
        "store*": true
      }
    }
  }
}
