{
  "models": {
    "mode": "merge",
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "apiKey": "${OPENROUTER_API_KEY}",
        "models": [
          {
            "id": "deepseek/deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "api": "openai-completions",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 500000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v4-flash"
      }
    },
    "entries": {
      "bench": {
        "workspace": "${OPENCLAW_HOME}/workspace/bench",
        "heartbeat": {
          "every": "0"
        },
        "thinkingDefault": "medium"
      }
    }
  },
  "mcp": {
    "servers": {
      "store": {
        "enabled": true,
        "url": "${BENCH_STORE_MCP}",
        "transport": "streamable-http"
      }
    }
  },
  "tools": {
    "allow": [
      "store__search_products",
      "store__get_product",
      "store__search_faq",
      "store__search_orders",
      "store__search_voucher",
      "store__view_cart",
      "store__add_to_cart",
      "store__remove_from_cart",
      "store__create_order",
      "store__call_support"
    ]
  }
}
