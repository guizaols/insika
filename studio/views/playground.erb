<header class="page-head">
  <h1>Playground<span class="sub">converse com um agente — dispara o mesmo <code>send_message</code> da API</span></h1>
</header>

<div class="playground"
     data-controller="live-transcript"
     data-live-transcript-session-value="<%= @session_id %>">
  <form class="card compose" method="post" action="/studio/playground">
    <%== csrf_tag %>
    <div class="row">
      <label>agente
        <select name="agent">
          <% @agents.each do |id| %>
            <option value="<%= id %>"<%== ' selected' if id == @agent %>><%= id %></option>
          <% end %>
        </select>
      </label>
      <label>session_id
        <input type="text" name="session_id" value="<%= @session_id %>" placeholder="em branco = nova conversa">
      </label>
    </div>
    <label>mensagem
      <textarea name="message" rows="3" placeholder="Pergunte algo ao agente…" required></textarea>
    </label>
    <div class="compose-actions">
      <span class="pill info" data-live-transcript-target="status">desconectado</span>
      <button type="submit" class="primary">enviar</button>
    </div>
  </form>

  <div class="card transcript">
    <div class="thread" data-live-transcript-target="stream"></div>
    <div class="empty" data-live-transcript-target="empty">
      <% if @session_id %>Aguardando eventos do turno…<% else %>Envie uma mensagem para começar.<% end %>
    </div>
  </div>
</div>
