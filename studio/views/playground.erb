<header class="page-head">
  <h1>Playground<span class="sub">chat with an agent — fires the same <code>send_message</code> as the API</span></h1>
</header>

<div class="playground"
     data-controller="live-transcript"
     data-live-transcript-session-value="<%= @session_id %>">
  <form class="card compose" method="post" action="/studio/playground">
    <%== csrf_tag %>
    <div class="row">
      <label>agent
        <select name="agent">
          <% @agents.each do |id| %>
            <option value="<%= id %>"<%== ' selected' if id == @agent %>><%= id %></option>
          <% end %>
        </select>
      </label>
      <label>session_id
        <input type="text" name="session_id" value="<%= @session_id %>" placeholder="empty = new conversation">
      </label>
    </div>
    <details class="pin">
      <summary>model override <span class="muted">— pins a NEW conversation (Chat › Agent › platform)</span></summary>
      <div class="row">
        <label>model
          <input type="text" name="model" placeholder="leave empty = agent/platform default">
        </label>
        <label>provider
          <input type="text" name="provider" placeholder="optional">
        </label>
      </div>
    </details>
    <label>message
      <textarea name="message" rows="3" placeholder="Ask the agent something…" required></textarea>
    </label>
    <div class="compose-actions">
      <span class="pill info" data-live-transcript-target="status">disconnected</span>
      <button type="submit" class="primary">Send</button>
    </div>
  </form>

  <div class="card transcript">
    <div class="thread" data-live-transcript-target="stream">
      <% Array(@history).each do |m| %><%== render("_message", locals: { m: m }) %><% end %>
      <% if @sent_message %><%== render("_message", locals: { m: { "role" => "user", "content" => @sent_message, "at" => nil } }) %><% end %>
    </div>
    <div class="empty" data-live-transcript-target="empty"<%== ' hidden' unless Array(@history).empty? && @sent_message.nil? %>>
      <% if @session_id %>Waiting for turn events…<% else %>Send a message to begin.<% end %>
    </div>
  </div>
</div>
