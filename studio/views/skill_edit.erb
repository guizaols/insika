<header class="page-head">
  <div>
    <nav class="crumbs"><a href="/studio/skills">skills</a> / <span><%= @skill_name.empty? ? "new" : @skill_name %></span></nav>
    <h1><%= @skill_name.empty? ? "New skill" : @skill_name %><span class="sub">a full SKILL.md — YAML frontmatter (<code>name</code>, <code>description</code>) + body</span></h1>
  </div>
</header>

<form class="card" method="post" action="/studio/skills" data-controller="dirty-guard">
  <%== csrf_tag %>
  <% unless @skill_name.empty? %>
    <input type="hidden" name="name" value="<%= @skill_name %>">
  <% end %>
  <% if @skill_name.empty? %>
    <label>name (canonical, same as the <code>name:</code> in the frontmatter)
      <input type="text" name="name" placeholder="my-skill" required>
    </label>
  <% end %>
  <div data-controller="code-editor" data-code-editor-language-value="markdown" data-code-editor-preview-value="true">
    <textarea name="content" data-code-editor-target="source" rows="20"><%= @skill_content %></textarea>
  </div>
  <div class="actions">
    <button type="submit" class="primary" data-turbo-submits-with="Saving…">Save skill</button>
    <a class="btn ghost" href="/studio/skills">← back</a>
  </div>
</form>
