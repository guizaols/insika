<header class="page-head">
  <h1>Skills<span class="sub"><%= @skills.size %> no catálogo · disco (seed) + autoradas (Store vence)</span></h1>
  <a class="btn primary" href="/studio/skills/new">+ nova skill</a>
</header>

<% if @skills.empty? %>
  <div class="empty">Nenhuma skill no catálogo ainda. Crie a primeira em <a href="/studio/skills/new">nova skill</a>.</div>
<% else %>
  <p class="muted matrix-hint">Marque em quais agentes cada skill fica disponível (<code>load_skill</code>). Um agente com allowlist “todas” não é alterado ao desmarcar.</p>
  <div class="skill-list">
    <% @skills.each do |s| %>
      <form class="card skill-card" method="post" action="/studio/skills/<%= Rack::Utils.escape(s.name) %>/agents">
        <%== csrf_tag %>
        <div class="skill-card-head">
          <div>
            <div class="skill-name mono"><%= s.name %>
              <% if @stored.include?(s.name) %><span class="pill info">autorada</span><% end %>
            </div>
            <div class="muted skill-desc"><%= s.description %></div>
          </div>
          <a class="btn ghost" href="/studio/skills/<%= Rack::Utils.escape(s.name) %>">editar</a>
        </div>
        <% if @agents.empty? %>
          <p class="muted">Nenhum agente configurado.</p>
        <% else %>
          <div class="check-grid">
            <% @agents.each do |a| %>
              <label class="check">
                <input type="checkbox" name="agent_ids[]" value="<%= a.id %>"<%== " checked" if skill_enabled_for?(a, s.name) %>>
                <span class="mono"><%= a.id %></span>
              </label>
            <% end %>
          </div>
          <div class="actions"><button type="submit" class="primary">aplicar aos agentes</button></div>
        <% end %>
      </form>
    <% end %>
  </div>
<% end %>
