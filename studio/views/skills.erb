<header class="page-head">
  <h1>Skills<span class="sub"><%= @skills.size %> in catalog · disk (seed) + authored (store wins)</span></h1>
  <a class="btn primary" href="/studio/skills/new">+ new skill</a>
</header>

<% if @skills.empty? %>
  <div class="empty">No skills in the catalog yet. Create the first one under <a href="/studio/skills/new">new skill</a>.</div>
<% else %>
  <p class="muted matrix-hint">Choose which agents each skill is available to (<code>load_skill</code>). An agent with an "all" allowlist is left untouched when you uncheck it.</p>
  <div data-controller="list-filter">
    <div class="filter-bar">
      <input type="search" class="filter-input" placeholder="Filter skills by name or description…" aria-label="Filter skills"
             data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
      <span class="filter-count mono muted" data-list-filter-target="count"></span>
    </div>
  <div class="skill-list">
    <% @skills.each do |s| %>
      <form class="card skill-card" method="post" action="/studio/skills/<%= Rack::Utils.escape(s.name) %>/agents"
            data-list-filter-target="item" data-filter-text="<%= s.name %> <%= s.description %>">
        <%== csrf_tag %>
        <div class="skill-card-head">
          <div>
            <div class="skill-name mono"><%= s.name %>
              <% if @stored.include?(s.name) %><span class="pill info">authored</span><% end %>
            </div>
            <div class="muted skill-desc"><%= s.description %></div>
          </div>
          <a class="btn ghost" href="/studio/skills/<%= Rack::Utils.escape(s.name) %>">Edit</a>
        </div>
        <% if @agents.empty? %>
          <p class="muted">No agents configured.</p>
        <% else %>
          <div class="check-grid">
            <% @agents.each do |a| %>
              <label class="check">
                <input type="checkbox" name="agent_ids[]" value="<%= a.id %>"<%== " checked" if skill_enabled_for?(a, s.name) %>>
                <span class="mono"><%= a.id %></span>
              </label>
            <% end %>
          </div>
          <div class="actions"><button type="submit" class="primary">Apply to agents</button></div>
        <% end %>
      </form>
    <% end %>
  </div>
    <div class="empty" data-list-filter-target="empty" hidden>No skills match your filter.</div>
  </div>
<% end %>
