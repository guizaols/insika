<!DOCTYPE html>
<html lang="en" data-theme="<%= theme_pref %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Harness Studio</title>
  <link rel="stylesheet" href="/studio/assets/dist/application.css">
  <script type="module" src="/studio/assets/dist/application.js" defer></script>
</head>
<body>
  <% if authenticated? %>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/studio/agents"><span class="dot"></span>Harness <small>Studio</small></a>

        <% nav_sections.each do |group, items| %>
          <div class="nav-group">
            <div class="nav-label"><%= group %></div>
            <nav class="nav" aria-label="<%= group %>">
              <% items.each do |label, href, icon| %>
                <a href="<%= href %>"<%== ' aria-current="page"' if request.path.start_with?(href.sub("/studio", "")) %>>
                  <%== nav_icon(icon) %><span class="lbl"><%= label %></span>
                </a>
              <% end %>
            </nav>
          </div>
        <% end %>

        <div class="sidebar-foot">
          <div class="health-card">
            <div class="row"><span class="pill ok online plain">runtime online</span></div>
            <div class="stat">
              <% health_parts.each do |label, value| %>
                <b><%= value %></b> <%= label %><br>
              <% end %>
            </div>
          </div>
          <div class="foot-actions">
            <div class="theme-switch" data-controller="theme" role="group" aria-label="theme">
              <% { "auto" => "auto", "light" => "light", "dark" => "dark" }.each do |val, label| %>
                <button type="button" class="theme-opt" data-theme-target="opt"
                        data-theme-value-param="<%= val %>" data-action="theme#set"><%= label %></button>
              <% end %>
            </div>
            <form class="logout" method="post" action="/studio/logout">
              <%== csrf_tag %>
              <button type="submit" class="ghost">Sign out</button>
            </form>
          </div>
        </div>
      </aside>

      <div class="app-main">
        <% if restart_needed? %>
          <div class="banner" role="status">
            <span><strong>Restart recommended.</strong> MCP changes take effect after the runtime restarts.</span>
            <form method="post" action="/studio/restart-ack">
              <%== csrf_tag %>
              <input type="hidden" name="back" value="<%= request.script_name %><%= request.path %>">
              <button type="submit" class="ghost">Dismiss</button>
            </form>
          </div>
        <% end %>

        <% if flash["error"] %>
          <div class="flash err" role="alert"><%= flash["error"] %></div>
        <% end %>
        <% if flash["notice"] %>
          <div class="flash ok" role="status"><%= flash["notice"] %></div>
        <% end %>

        <main class="page">
          <%== yield %>
        </main>
      </div>
    </div>
  <% else %>
    <% if flash["error"] %>
      <div class="flash err" role="alert"><%= flash["error"] %></div>
    <% end %>
    <main class="page auth-page">
      <%== yield %>
    </main>
  <% end %>
</body>
</html>
