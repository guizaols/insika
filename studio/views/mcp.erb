<header class="page-head">
  <div>
    <nav class="crumbs"><a href="/studio/agents">agents</a> / <span>mcp</span></nav>
    <h1>MCP<span class="sub"><%= @instances.size %> instance(s) · credentials masked</span></h1>
  </div>
</header>

<p class="muted matrix-hint">MCP server instances (durable config). Credentials in <code>env</code> never come back in plaintext — each value shows as <code><%= secret_sentinel %></code>; keeping it preserves the secret, changing it replaces, clearing the line removes it.</p>

<% if @instances.empty? %>
  <div class="empty">No MCP instances. Add one below (e.g. <code>tavily</code>) to expose an MCP server to your agents' tools.</div>
<% end %>

<% @instances.each do |m| %>
  <div class="card promptfile">
    <div class="promptfile-head">
      <strong class="mono"><%= m["name"] %>
        <% if m["enabled"] %><span class="pill ok">on</span><% else %><span class="pill warn">off</span><% end %>
      </strong>
      <form method="post" action="/studio/mcp/delete" data-turbo-confirm="Remove MCP instance &quot;<%= m["name"] %>&quot;? Agents stop seeing its tools next turn.">
        <%== csrf_tag %>
        <input type="hidden" name="name" value="<%= m["name"] %>">
        <button type="submit" class="ghost danger" data-turbo-submits-with="Removing…">Remove</button>
      </form>
    </div>
    <form method="post" action="/studio/mcp">
      <%== csrf_tag %>
      <input type="hidden" name="name" value="<%= m["name"] %>">
      <div class="grid-2">
        <label>transport
          <select name="transport">
            <% %w[stdio http sse].each do |t| %>
              <option value="<%= t %>"<%== " selected" if m["transport"] == t %>><%= t %></option>
            <% end %>
          </select>
        </label>
        <label class="check">
          <input type="checkbox" name="enabled" value="1"<%== " checked" if m["enabled"] %>>
          enabled
        </label>
      </div>
      <label>command <span class="muted">(stdio)</span>
        <input type="text" name="command" value="<%= m["command"] %>" placeholder="npx -y @modelcontextprotocol/server-...">
      </label>
      <label>url <span class="muted">(http/sse)</span>
        <input type="text" name="url" value="<%= m["url"] %>" placeholder="https://mcp.example.com">
      </label>
      <label>description
        <input type="text" name="description" value="<%= m["description"] %>">
      </label>
      <label>env <span class="muted">(one <code>KEY=value</code> per line)</span>
        <textarea name="env" rows="4"><%= env_lines(m["env"]) %></textarea>
      </label>
      <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Saving…">Save instance</button></div>
    </form>
  </div>
<% end %>

<details class="card newfile">
  <summary>+ new MCP instance</summary>
  <form method="post" action="/studio/mcp">
    <%== csrf_tag %>
    <div class="grid-2">
      <label>name <span class="muted">(slug)</span>
        <input type="text" name="name" placeholder="tavily" required>
      </label>
      <label>transport
        <select name="transport">
          <% %w[stdio http sse].each do |t| %><option value="<%= t %>"><%= t %></option><% end %>
        </select>
      </label>
    </div>
    <label class="check">
      <input type="checkbox" name="enabled" value="1" checked>
      enabled
    </label>
    <label>command <span class="muted">(stdio)</span>
      <input type="text" name="command" placeholder="npx -y @modelcontextprotocol/server-...">
    </label>
    <label>url <span class="muted">(http/sse)</span>
      <input type="text" name="url" placeholder="https://mcp.example.com">
    </label>
    <label>description
      <input type="text" name="description">
    </label>
    <label>env <span class="muted">(one <code>KEY=value</code> per line)</span>
      <textarea name="env" rows="4" placeholder="TAVILY_API_KEY=tvly-…"></textarea>
    </label>
    <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Creating…">Create instance</button></div>
  </form>
</details>
