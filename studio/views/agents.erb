<header class="page-head">
  <h1>Agentes<span class="sub"><%= @agents.size %> configurado(s) · cada um a sua BIA</span></h1>
  <a class="btn primary" href="/studio/playground">testar no playground →</a>
</header>

<% if @agents.empty? %>
  <div class="empty">Nenhum agente ainda. Crie a sua primeira BIA abaixo (id + modelo) e dê identidade a ela na página de detalhe.</div>
<% else %>
  <div class="agent-grid">
    <% @agents.each do |a| %>
      <article class="card agent">
        <a class="agent-head" href="/studio/agents/<%= Rack::Utils.escape(a.id) %>">
          <span class="avatar"><%= a.id[0, 2].upcase %></span>
          <div>
            <div class="agent-id"><%= a.id %></div>
            <div class="muted mono"><%= a.model %><%== " · #{h(a.provider)}" if a.provider %></div>
          </div>
          <% if a.memory %><span class="pill info">memória</span><% end %>
        </a>
        <dl class="agent-meta">
          <div><dt>tools</dt><dd><%= a.tools_allow.nil? ? "todas" : a.tools_allow.size %></dd></div>
          <div><dt>skills</dt><dd><%= a.skills.nil? ? "todas" : Array(a.skills).size %></dd></div>
          <div><dt>prompts</dt><dd><%= Array(a.prompt_files).size %></dd></div>
        </dl>
        <div class="agent-actions">
          <a class="btn" href="/studio/agents/<%= Rack::Utils.escape(a.id) %>">editar</a>
          <a class="btn ghost" href="/studio/playground?agent=<%= Rack::Utils.escape(a.id) %>">testar</a>
        </div>
      </article>
    <% end %>
  </div>
<% end %>

<details class="card newfile"<%== " open" if @agents.empty? %>>
  <summary>+ novo agente</summary>
  <form method="post" action="/studio/agents">
    <%== csrf_tag %>
    <div class="grid-2">
      <label>id <span class="muted">(slug único, ex.: bia)</span>
        <input type="text" name="id" placeholder="bia" required>
      </label>
      <label>modelo
        <input type="text" name="model" placeholder="deepseek-chat" required>
      </label>
    </div>
    <label>provider <span class="muted">(opcional)</span>
      <input type="text" name="provider" placeholder="deepseek">
    </label>
    <label class="check">
      <input type="checkbox" name="memory" value="1" checked>
      memória cross-session (a BIA lembra entre conversas)
    </label>
    <div class="actions"><button type="submit" class="primary">criar agente</button></div>
  </form>
</details>
