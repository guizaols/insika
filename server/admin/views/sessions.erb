<%= style %>
<h1>Sessions</h1>
<%= nav %>
<% if @sessions.empty? -%>
  <p class="muted">Nenhuma sessão.</p>
<% else -%>
  <table>
    <tr><th>id</th><th>mensagens</th><th>atualizada</th></tr>
    <% @sessions.each do |s| -%>
      <tr>
        <td><a href="/admin/sessions/<%= h(s[:id]) %>"><%= h(s[:id]) %></a></td>
        <td><%= h(s[:count]) %></td>
        <td><%= h(s[:updated_at]) %></td>
      </tr>
    <% end -%>
  </table>
<% end -%>
