<%= style %>
<%= header("Sessions", "sessões e seus transcripts") %>
<% if @sessions.empty? -%>
  <div class="empty">Nenhuma sessão.</div>
<% else -%>
  <div class="card" style="padding:.25rem .9rem">
    <table>
      <tr><th>id</th><th>mensagens</th><th>atualizada</th></tr>
      <% @sessions.each do |s| -%>
        <tr>
          <td><a href="/admin/sessions/<%= h(s[:id]) %>"><code><%= h(s[:id]) %></code></a></td>
          <td class="mono"><%= h(s[:count]) %></td>
          <td class="mono muted"><%= h(s[:updated_at]) %></td>
        </tr>
      <% end -%>
    </table>
  </div>
<% end -%>
</div>
