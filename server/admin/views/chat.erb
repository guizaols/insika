<%= style %>
<h1>Chat — testar o agente</h1>
<%= nav %>
<p class="muted">
  POSTa <code>send_message</code> (o mesmo Command da API). Acompanhe o turno ao
  vivo em <a href="/admin/events">Events</a> (filtre por task_id/session_id) ou
  em <a href="/admin/tasks">Tasks</a>.
</p>

<div id="flash"></div>

<form method="post" action="/admin/chat">
  <p><label>agente <input type="text" name="agent" value="sales"></label></p>
  <p><label>session_id (opcional) <input type="text" name="session_id"></label></p>
  <p><label>mensagem<br><textarea name="message" rows="4" cols="60"></textarea></label></p>
  <button type="submit">enviar</button>
</form>

<script src="/admin/assets/turbo.js"></script>
