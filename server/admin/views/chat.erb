<%= style %>
<%= header("Chat", "testar o agente — POSTa o mesmo send_message da API") %>
<p class="muted">
  Acompanhe o turno ao vivo em <a href="/admin/events">Events</a> (filtre por
  task_id/session_id) ou em <a href="/admin/tasks">Tasks</a>.
</p>

<div id="flash"></div>

<form method="post" action="/admin/chat" class="card">
  <p><label>agente<br><input type="text" name="agent" value="sales"></label></p>
  <p><label>session_id (opcional)<br><input type="text" name="session_id"></label></p>
  <p><label>mensagem<br><textarea name="message" rows="4" cols="60" style="font:inherit;width:100%;max-width:38rem;padding:.5rem;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text)"></textarea></label></p>
  <button type="submit" class="primary">enviar</button>
</form>

<script src="/admin/assets/turbo.js"></script>
</div>
