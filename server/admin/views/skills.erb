<%= style %>
<%= header("Skills", "catálogo — progressive disclosure via load_skill") %>
<% if @skills.empty? -%>
  <div class="empty">Nenhuma skill no catálogo.</div>
<% else -%>
  <% @skills.each do |skill| -%>
    <div class="card">
      <div class="toolbar" style="justify-content:space-between">
        <strong><%= h(skill.name) %></strong>
        <code class="muted"><%= h(skill.path) %></code>
      </div>
      <p style="margin:.4rem 0 0"><%= h(skill.description) %></p>
      <details style="margin-top:.5rem">
        <summary class="muted" style="cursor:pointer">corpo</summary>
        <pre><%= h(skill.body) %></pre>
      </details>
    </div>
  <% end -%>
<% end -%>
</div>
