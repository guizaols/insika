<%= style %>
<%= header("Tasks", "status, executions e checkpoints") %>
<% if @tasks.empty? -%>
  <div class="empty">Nenhuma task.</div>
<% else -%>
  <div class="card" style="padding:.25rem .9rem">
    <table>
      <tr><th>id</th><th>status</th><th>session</th><th>executions</th><th>atualizada</th></tr>
      <% @tasks.each do |t| -%>
        <tr>
          <td><a href="/admin/tasks/<%= h(t.id) %>"><code><%= h(t.id) %></code></a></td>
          <td><%= status_pill(t.status) %></td>
          <td class="mono muted"><%= t.session_id ? h(t.session_id) : "—" %></td>
          <td class="mono"><%= h(t.executions.size) %></td>
          <td class="mono muted"><%= h(t.updated_at) %></td>
        </tr>
      <% end -%>
    </table>
  </div>
<% end -%>
</div>
