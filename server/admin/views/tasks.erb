<%= style %>
<h1>Tasks</h1>
<%= nav %>
<% if @tasks.empty? -%>
  <p class="muted">Nenhuma task.</p>
<% else -%>
  <table>
    <tr><th>id</th><th>status</th><th>session</th><th>executions</th><th>atualizada</th></tr>
    <% @tasks.each do |t| -%>
      <tr>
        <td><a href="/admin/tasks/<%= h(t.id) %>"><%= h(t.id) %></a></td>
        <td><%= h(t.status) %></td>
        <td><%= h(t.session_id) %></td>
        <td><%= h(t.executions.size) %></td>
        <td><%= h(t.updated_at) %></td>
      </tr>
    <% end -%>
  </table>
<% end -%>
