<%= style %>
<%= header("Events ao vivo", "stream de /v1/events via EventSource") %>
<p class="muted">
  Mesma origem, sem header de auth (API do consumidor, fora do /admin). Os
  eventos de tool/skill viram cards; o texto do modelo aparece como bolha.
</p>

<form id="filters" class="toolbar card" onsubmit="return connect();">
  <label>task_id <input id="task_id" type="text"></label>
  <label>session_id <input id="session_id" type="text"></label>
  <button type="submit" class="primary">conectar</button>
  <button type="button" onclick="stop()">parar</button>
  <span id="status" class="pill info" style="margin-left:auto">desconectado</span>
</form>

<div id="stream" class="thread" style="margin-top:1rem"></div>
<div id="empty" class="empty">Aguardando eventos…</div>
</div>

<script>
  var es = null, streamEl = document.getElementById("stream"), emptyEl = document.getElementById("empty");
  var statusEl = document.getElementById("status"), curContent = null;

  function setStatus(txt, cls){ statusEl.textContent = txt; statusEl.className = "pill " + cls; statusEl.style.marginLeft = "auto"; }
  function stop(){ if (es){ es.close(); es = null; } setStatus("desconectado","info"); }

  function el(tag, cls, text){ var e = document.createElement(tag); if(cls) e.className = cls; if(text!=null) e.textContent = text; return e; }
  function pre(obj){ var p = el("pre"); p.textContent = (typeof obj === "string") ? obj : JSON.stringify(obj, null, 2); return p; }
  function push(node){ emptyEl.style.display = "none"; streamEl.appendChild(node); node.scrollIntoView({block:"end"}); }

  function toolcard(kind, arrow, title, body){
    var c = el("div", "toolcard " + kind);
    var h = el("div", "h"); h.appendChild(el("span","arrow",arrow)); h.appendChild(el("strong",null,title));
    c.appendChild(h); if (body!=null) c.appendChild(pre(body)); return c;
  }
  function chip(ev){
    var c = el("div", "toolcard"); c.style.borderLeftColor = "var(--muted)";
    var h = el("div","h"); h.appendChild(el("strong",null,ev.type));
    var meta = ev.meta || {}; var tag = meta.task_id || meta.session_id;
    if (tag) h.appendChild(el("span","muted"," · " + tag));
    if (ev.message) h.appendChild(el("span","muted"," · " + ev.message));
    c.appendChild(h); return c;
  }

  function render(ev){
    switch (ev.type){
      case "content":
        if (!curContent){
          var msg = el("div","msg assistant"); msg.appendChild(el("div","who","A"));
          var b = el("div","bubble"); curContent = el("div","content",""); b.appendChild(curContent); msg.appendChild(b);
          push(msg);
        }
        curContent.textContent += (ev.delta || ""); break;
      case "tool_call":
        curContent = null;
        push(toolcard("", "→", (ev.name||"tool") + "(...)", ev.arguments)); break;
      case "tool_result":
        push(toolcard("result", "←", ev.name||"tool", ev.result)); break;
      case "skill_activated":
        push(toolcard("skill", "↑", "load_skill(" + (ev.name||"") + ")", null)); break;
      default:
        curContent = null; push(chip(ev));
    }
  }

  function connect(){
    stop();
    var params = new URLSearchParams();
    var t = document.getElementById("task_id").value, s = document.getElementById("session_id").value;
    if (t) params.set("task_id", t); if (s) params.set("session_id", s);
    var url = "/v1/events" + (params.toString() ? "?" + params.toString() : "");
    streamEl.innerHTML = ""; emptyEl.style.display = "block"; emptyEl.textContent = "Aguardando eventos…"; curContent = null;
    es = new EventSource(url);
    setStatus("conectando…","warn");
    es.onopen = function(){ setStatus("conectado","ok"); };
    es.onmessage = function(e){ try { render(JSON.parse(e.data)); } catch (err) { push(el("div","muted",e.data)); } };
    es.onerror = function(){ setStatus("desconectado","err"); };
    return false;
  }
  connect();
</script>
