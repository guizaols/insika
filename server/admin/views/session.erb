<%= style %>
<%= header("Session", h(@id)) %>
<p><a href="/admin/sessions">&larr; todas as sessões</a></p>

<h2>vars</h2>
<div class="card">
  <% if @session.vars.nil? || @session.vars.empty? -%>
    <span class="muted">Sem vars.</span>
  <% else -%>
    <div class="grid">
      <% @session.vars.each do |k, v| -%>
        <div><div class="k muted" style="font-size:.72rem;text-transform:uppercase"><%= h(k) %></div>
             <div class="mono"><%= h(v) %></div></div>
      <% end -%>
    </div>
  <% end -%>
</div>

<h2>transcript · <%= h(@session.messages.size) %> mensagens</h2>
<% if @session.messages.empty? -%>
  <div class="empty">Sem mensagens nesta sessão.</div>
<% else -%>
  <div class="thread">
    <% @session.messages.each do |m| -%>
      <% role = (m["role"] || m[:role]).to_s -%>
      <% klass = %w[user assistant tool].include?(role) ? role : "assistant" -%>
      <% initial = role.empty? ? "?" : role[0].upcase -%>
      <div class="msg <%= klass %>">
        <div class="who"><%= h(initial) %></div>
        <div class="bubble">
          <div class="content"><%= h(m["content"] || m[:content]) %></div>
          <% at = m["at"] || m[:at] -%>
          <% if at -%><div class="meta"><%= h(role) %> · <%= h(at) %></div><% end -%>
        </div>
      </div>
    <% end -%>
  </div>
<% end -%>
</div>
