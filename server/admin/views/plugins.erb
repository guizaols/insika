<%= style %>
<%= header("Plugins", "tools e workflows por plugin") %>
<p class="muted">Agrupado por <code>Entry#plugin</code> dos registries (nil = sistema/wiring).</p>
<% if @groups.empty? -%>
  <div class="empty">Nenhum registro.</div>
<% else -%>
  <% @groups.each do |g| -%>
    <div class="card">
      <div class="toolbar" style="justify-content:space-between">
        <strong><%= g[:plugin].nil? ? "(sistema)" : h(g[:plugin]) %></strong>
        <span class="toolbar">
          <span class="pill info"><%= h(g[:tools].size) %> tools</span>
          <span class="pill info"><%= h(g[:workflows].size) %> workflows</span>
        </span>
      </div>

      <% unless g[:tools].empty? -%>
        <h2 style="margin:.9rem 0 .3rem">tools</h2>
        <table>
          <tr><th>name</th><th>metadata</th></tr>
          <% g[:tools].each do |e| -%>
            <tr><td><code><%= h(e.name) %></code></td><td><pre><%= h(e.metadata) %></pre></td></tr>
          <% end -%>
        </table>
      <% end -%>

      <% unless g[:workflows].empty? -%>
        <h2 style="margin:.9rem 0 .3rem">workflows</h2>
        <table>
          <tr><th>name</th><th>metadata</th></tr>
          <% g[:workflows].each do |e| -%>
            <tr><td><code><%= h(e.name) %></code></td><td><pre><%= h(e.metadata) %></pre></td></tr>
          <% end -%>
        </table>
      <% end -%>
    </div>
  <% end -%>
<% end -%>
</div>
