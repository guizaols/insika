<%= style %>
<%= header("Task", h(@task.id)) %>
<p><a href="/admin/tasks">&larr; todas as tasks</a></p>

<div class="card toolbar">
  <span>status: <%= status_pill(@task.status) %></span>
  <% if @task.session_id -%>
    <span class="muted">·</span>
    <span>session: <a href="/admin/sessions/<%= h(@task.session_id) %>"><code><%= h(@task.session_id) %></code></a></span>
  <% end -%>
</div>

<div id="flash"></div>

<%# ações de operador (P2-04): forms normais (POST) — com Turbo viram turbo_stream %>
<h2>ações</h2>
<div class="toolbar">
  <form method="post" action="/admin/tasks/<%= h(@task.id) %>/pause">
    <button type="submit">pausar</button>
  </form>
  <form method="post" action="/admin/tasks/<%= h(@task.id) %>/resume">
    <button type="submit" class="primary">retomar</button>
  </form>
  <form method="post" action="/admin/tasks/<%= h(@task.id) %>/cancel">
    <button type="submit" class="danger">cancelar</button>
  </form>
</div>

<% unless (@pending || []).empty? -%>
  <h2>aprovações pendentes</h2>
  <% @pending.each do |pa| -%>
    <div class="card">
      <div class="toolbar" style="justify-content:space-between">
        <span><code><%= h(pa.tool) %></code></span>
        <span class="toolbar">
          <form method="post" action="/admin/approvals/<%= h(pa.id) %>">
            <input type="hidden" name="decision" value="approved">
            <button type="submit" class="primary">aprovar</button>
          </form>
          <form method="post" action="/admin/approvals/<%= h(pa.id) %>">
            <input type="hidden" name="decision" value="rejected">
            <button type="submit" class="danger">rejeitar</button>
          </form>
        </span>
      </div>
      <pre><%= h(pa.args) %></pre>
    </div>
  <% end -%>
<% end -%>

<h2>command</h2>
<pre><%= h(@task.command) %></pre>

<h2>executions · <%= h(@task.executions.size) %></h2>
<% if @task.executions.empty? -%>
  <div class="empty">Nenhuma execution.</div>
<% else -%>
  <div class="card" style="padding:.25rem .9rem">
    <table>
      <tr><th>attempt</th><th>started</th><th>finished</th><th>outcome</th><th>error</th></tr>
      <% @task.executions.each do |e| -%>
        <tr>
          <td class="mono"><%= h(e.attempt) %></td>
          <td class="mono"><%= h(e.started_at) %></td>
          <td class="mono"><%= h(e.finished_at) %></td>
          <td><%= status_pill(e.outcome) %></td>
          <td><% if e.error %><pre><%= h(e.error) %></pre><% else %><span class="muted">—</span><% end %></td>
        </tr>
      <% end -%>
    </table>
  </div>
<% end -%>

<h2>checkpoint mais recente</h2>
<% if @checkpoint.nil? -%>
  <div class="empty">sem checkpoint</div>
<% else -%>
  <div class="grid">
    <div class="card"><div class="k">turn</div><div class="v"><%= h(@checkpoint.turn) %></div></div>
    <div class="card"><div class="k">mensagens</div><div class="v"><%= h(@checkpoint.messages.size) %></div></div>
    <div class="card"><div class="k">side effects</div><div class="v"><%= h(@checkpoint.completed_side_effects.size) %></div></div>
    <div class="card"><div class="k">created</div><div class="mono" style="margin-top:.35rem"><%= h(@checkpoint.created_at) %></div></div>
  </div>
  <% unless @checkpoint.completed_side_effects.empty? -%>
    <pre><%= h(@checkpoint.completed_side_effects) %></pre>
  <% end -%>
<% end -%>

<script src="/admin/assets/turbo.js"></script>
</div>
