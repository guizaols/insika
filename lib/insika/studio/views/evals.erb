<div class="reports-page reports-evals">
<header class="page-head">
  <div>
    <%== crumbs_for("Evals") %>
    <h1>Evals<span class="sub">Cases that check your agents</span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/evals", @filter) %>
    <a class="btn" href="/studio/evals<%= "?agent=#{Rack::Utils.escape(@filter)}" if @filter %>">New case</a>
    <a class="btn" href="/studio/settings?s=evals">Configure judges</a>
  </div>
</header>

<% if @invalid.any? %>
  <div class="empty">
    <strong><%= @invalid.size %> case(s) no longer validate</strong> and are SKIPPED by a run:
    <span class="mono"><%= @invalid.join(", ") %></span>. Fix the YAML or re-import the corpus
    (<code>insika evals:import</code>).
  </div>
<% end %>

<div class="drill report-workspace" data-controller="list-filter">
  <aside class="drill-pane drill-master">
    <div class="drill-pane-head"><div class="title"><strong>Cases <span class="count"><%= @cases.size %> case(s)</span></strong></div></div>
    <div class="drill-search">
      <input type="search" class="filter-input" placeholder="Search cases…" aria-label="Filter cases by ID, agent or opening message" data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
    </div>
    <nav class="drill-pane-body drill-list" aria-label="eval cases">
      <% if @cases.empty? %>
        <div class="empty">No case yet. Seed the corpus with <code>insika evals:import</code>, or write one on the right.</div>
      <% end %>
      <% @by_agent.each do |agent, cases| %>
        <div class="nav-label"><%= agent %></div>
        <% cases.each do |g| %>
          <a class="drill-item<%== ' active' if @case && @case.id == g.id %>" href="/studio/evals?<%= Rack::Utils.build_query({ "id" => g.id, "agent" => @filter }.compact) %>" data-list-filter-target="item" data-filter-text="<%= g.id %> <%= agent %> <%= g.opens_with %>"<%== ' aria-current="page"' if @case && @case.id == g.id %>>
            <div class="drill-item-name"><span class="txt mono"><%= g.id %></span><% if g.rubric.to_s.strip.empty? %><span class="pill info plain">no rubric</span><% end %><% if g.simulated? %><span class="pill accent plain">simulated</span><% end %></div>
            <div class="drill-item-sub"><%= g.opens_with.to_s %></div>
          </a>
        <% end %>
      <% end %>
      <% if @cases.any? %><div class="empty" data-list-filter-target="empty" hidden>No cases match your search.</div><% end %>
    </nav>
  </aside>

  <section class="drill-pane drill-detail">
    <div class="drill-pane-head">
      <div class="title"><strong><%= @case ? @case.id : "New case" %></strong></div>
      <div class="actions">
        <% if @case %>
          <form method="post" action="/studio/evals/<%= Rack::Utils.escape(@case.id) %>/delete"
                data-turbo-confirm="Remove case &quot;<%= @case.id %>&quot;? The corpus on disk is the way back.">
            <%== csrf_tag %>
            <button type="submit" class="ghost danger" data-turbo-submits-with="Removing…">Remove</button>
          </form>
        <% end %>
        <button type="submit" form="set-golden" class="btn primary" data-turbo-submits-with="Saving…">Save</button>
      </div>
    </div>
    <div class="drill-pane-body">
      <p class="muted">Define the conversation and the behavior you expect. Saving validates the case before adding it to your corpus.</p>
      <details class="report-details">
        <summary>Case format and scoring</summary>
        <p>Cases use the same YAML as the corpus files. <code>expect.rubric</code> describes what the judge scores; <code>tools_called</code> and <code>must_not</code> are checked without a model.</p>
        <p>Import cases with <code>insika evals:import</code>. Configure judges in Settings.</p>
      </details>
      <%
        # Erubi's tag scanner is a plain text scanner: it has no notion of Ruby
        # comments, strings or heredocs, so it closes a code tag on the first
        # literal percent-angle-bracket close marker it sees, wherever it is.
        # A heredoc opened here therefore has to open, hold its whole body and
        # close ALL inside this one tag, with that close marker appearing
        # nowhere in between (not even in a comment) - otherwise the template
        # text and its compiled buffer-append boilerplate between two tags
        # gets spliced into the middle of the heredoc's own string value,
        # which is how compiler internals ended up leaking into this textarea.
        default_case_yaml = <<~YAML
          id: my-agent-coupon
          agent: my-agent
          turns:
            - user: "tem cupom de desconto?"
          expect:
            tools_called:
              - search_voucher
            must_not:
              - pii_leak
              - tool_error
            rubric: |
              Consults the active coupon with the tool and says what it is — does NOT
              invent a code or a discount. If there is none, says so kindly.
            min_score: 0.7
        YAML
      %>
      <form id="set-golden" method="post" action="/studio/evals" data-controller="dirty-guard">
        <%== csrf_tag %>
        <input type="hidden" name="id" value="<%= @case&.id %>">
        <label>case (YAML)
          <textarea name="yaml" rows="22" spellcheck="false" class="mono"><%= @case_yaml || default_case_yaml %></textarea>
        </label>
      </form>
    </div>
  </section>
</div>

</div>
