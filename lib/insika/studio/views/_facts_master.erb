<%# Master column of the Facts miller shell — rendered by the index
    (facts.erb) and the detail (fact_detail.erb). ONE queue, pending first
    (oldest first — evidence ages), then stale (the CAS-lost re-presents),
    then recent (the audit trail) — never per-status pages, just labelled
    groups in the same scrollable list. Rows target the fact-detail
    turbo-frame with data-turbo-action="advance": the detail loads beside the
    list while the URL moves, so refresh/deep-link render the same screen.
    Local: active_id lights the current row. %>
<aside class="drill-pane drill-master">
  <div class="drill-pane-head">
    <div class="title"><strong>Review queue <span class="count"><%= @pending.size + @stale.size + @recent.size %></span></strong><span class="count">Oldest pending first</span></div>
  </div>
  <div class="drill-search">
    <input type="search" class="filter-input" placeholder="Search facts…" aria-label="Filter facts by key, value or scope"
           data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
  </div>
  <nav class="drill-pane-body drill-list" aria-label="facts" data-controller="active-link">
    <% if @pending.empty? && @stale.empty? && @recent.empty? %>
      <div class="empty">Nothing to show yet.</div>
    <% else %>
      <% [["Pending", @pending], ["Stale", @stale], ["Recent", @recent]].each do |label, rows| %>
        <% next if rows.empty? %>
        <div class="drill-group-label"><%= label %><span><%= rows.size %></span></div>
        <% rows.each do |p| %>
          <a class="drill-item<%== ' active' if p.id == active_id %>"
             href="/studio/facts/<%= Rack::Utils.escape(p.id) %><%= "?agent=#{Rack::Utils.escape(@filter)}" if @filter %>"
             data-turbo-frame="fact-detail" data-turbo-action="advance"
             data-list-filter-target="item" data-filter-text="<%= p.key %> <%= p.key.tr('_', ' ') %> <%= p.value %> <%= p.scope %>"
             data-active-link-target="item" data-action="click->active-link#select">
            <span class="fact-item-key"><%= p.key.tr("_", " ").sub(/\A./, &:upcase) %></span>
            <strong class="fact-item-value"><%= p.value %></strong>
            <div class="drill-item-sub fact-item-meta">
              <span class="status <%= status_class(p.status) %>"><%= p.status %></span>
              <span class="fact-item-age"><%= time_ago(%w[pending stale].include?(p.status) ? p.created_at : p.updated_at) %></span>
            </div>
          </a>
        <% end %>
      <% end %>
      <div class="empty" data-list-filter-target="empty" hidden>No facts match your filter.</div>
    <% end %>
  </nav>
</aside>
