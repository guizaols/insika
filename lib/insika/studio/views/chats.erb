<%# Chats — miller columns: master list | detail frame. A row click loads the
    session viewer beside the list (no full page load) and advances the URL,
    same shell as Agents/Customers/Refinement. The detail pane's landing state
    just points at the playground — there is no "create a session" form here,
    conversations are born there, not authored in Studio. %>
<header class="page-head operation-head">
  <div>
    <nav class="crumbs"><a href="/studio/agents">agents</a></nav>
    <h1>Chats<span class="sub"><%= @sessions.size %> recent conversations</span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/chats", @agent) %>
    <a class="btn primary" href="/studio/playground">New conversation</a>
  </div>
</header>

<div class="drill operation-workspace" data-controller="list-filter">
  <%== render("_chats_master", locals: { active_id: nil }) %>

  <turbo-frame id="session-detail" class="drill-pane drill-detail">
    <div class="drill-pane-head">
      <div class="title">
        <strong>Pick a conversation</strong>
        <span class="count">select on the left, or start a new one in the playground</span>
      </div>
    </div>
    <div class="drill-empty">
      <div><h2>Read the conversation</h2><p>Review messages, the latest briefing and stage history. New messages appear as they arrive.</p></div>
    </div>
  </turbo-frame>
</div>
