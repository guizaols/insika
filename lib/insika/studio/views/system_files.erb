<header class="page-head">
  <div>
    <nav class="crumbs"><a href="/studio/agents">agents</a> / <span>system files</span></nav>
    <h1>System files<span class="sub"><%= @system_files.size %> file(s) · apply to every agent</span></h1>
  </div>
</header>

<p class="muted matrix-hint">GLOBAL prompts/rules: the runtime injects these files <strong>before</strong> each agent's own identity, every turn. Store-backed and versioned (like per-agent prompts). Empty = no global injection (the prompt stays exactly as before).</p>

<% if @system_files.empty? %>
  <div class="empty">No system files. Create one below (e.g. <code>HOUSE_RULES.md</code>) for a rule that applies to every agent.</div>
<% end %>

<% @system_files.each do |sf| %>
  <div class="card promptfile">
    <div class="promptfile-head">
      <strong class="mono"><%= sf[:name] %></strong>
      <form method="post" action="/studio/system-files/delete" data-turbo-confirm="Remove system file &quot;<%= sf[:name] %>&quot;? This can't be undone.">
        <%== csrf_tag %>
        <input type="hidden" name="file" value="<%= sf[:name] %>">
        <button type="submit" class="ghost danger" data-turbo-submits-with="Removing…">Remove</button>
      </form>
    </div>
    <form method="post" action="/studio/system-files" data-controller="dirty-guard">
      <%== csrf_tag %>
      <input type="hidden" name="file" value="<%= sf[:name] %>">
      <div data-controller="code-editor" data-code-editor-language-value="markdown">
        <textarea name="content" data-code-editor-target="source" rows="10"><%= sf[:content] %></textarea>
      </div>
      <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Saving…">Save file</button></div>
    </form>
    <% unless sf[:versions].empty? %>
      <details class="versions">
        <summary><%= sf[:versions].size %> previous version(s)</summary>
        <ul>
          <% sf[:versions].each_with_index do |v, i| %>
            <li>
              <span class="muted mono"><%= v["at"] %></span>
              <form method="post" action="/studio/system-files/restore">
                <%== csrf_tag %>
                <input type="hidden" name="file" value="<%= sf[:name] %>">
                <input type="hidden" name="version" value="<%= i %>">
                <button type="submit" class="ghost">Restore</button>
              </form>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
<% end %>

<details class="card newfile">
  <summary>+ new system file</summary>
  <form method="post" action="/studio/system-files" data-controller="dirty-guard">
    <%== csrf_tag %>
    <label>file name
      <input type="text" name="file" placeholder="HOUSE_RULES.md" required>
    </label>
    <div data-controller="code-editor" data-code-editor-language-value="markdown">
      <textarea name="content" data-code-editor-target="source" rows="8" placeholder="# House rules&#10;Every agent must..."></textarea>
    </div>
    <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Creating…">Create file</button></div>
  </form>
</details>
