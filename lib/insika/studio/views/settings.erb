<%# Settings — drill-down (T2): section list | selected section's form(s).
   @section (general|models|llm) comes from ?s= and drives the detail. %>
<% sections = [
     ["general", "General", "streaming, timeouts"],
     ["models",  "Model defaults", "platform model layer (Chat › Agent › platform)"],
     ["edge",    "Edge limits", "rate-limit per chat, token ceiling per agent"],
     ["evals",   "Evals", "who grades a rubric, and how a panel agrees"],
     ["llm",     "LLM providers", "keys, base URL, models per provider"]
   ] %>
<div class="drill">
  <aside class="drill-pane drill-master">
    <div class="drill-pane-head"><div class="title"><strong>Settings</strong></div></div>
    <nav class="drill-pane-body drill-list" aria-label="settings sections">
      <% sections.each do |key, label, sub| %>
        <a class="drill-item<%== ' active' if @section == key %>" href="/studio/settings?s=<%= key %>">
          <div class="drill-item-name"><span class="txt"><%= label %></span><% if key == "llm" %><span class="pill info plain"><%= @providers.size %></span><% end %></div>
          <div class="drill-item-sub"><%= sub %></div>
        </a>
      <% end %>
    </nav>
  </aside>

  <section class="drill-pane drill-detail">
    <% if @section == "general" %>
      <div class="drill-pane-head">
        <div class="title"><strong>General</strong></div>
        <button type="submit" form="set-general" class="btn primary" data-turbo-submits-with="Saving…">Save</button>
      </div>
      <div class="drill-pane-body">
        <p class="muted">Streaming and timeouts — saved via <code>update_settings</code> (durable, applies next turn).</p>
        <form id="set-general" method="post" action="/studio/settings">
          <%== csrf_tag %>
          <label class="check">
            <input type="checkbox" name="streaming" value="1"<%== " checked" if @settings["streaming"] %>>
            stream model responses
          </label>
          <div class="grid-2">
            <label>request_timeout (s)<input type="text" name="request_timeout" value="<%= @settings["request_timeout"] %>" inputmode="numeric"></label>
            <label>max_retries<input type="text" name="max_retries" value="<%= @settings["max_retries"] %>" inputmode="numeric"></label>
            <label>turn_timeout (s)<input type="text" name="turn_timeout" value="<%= @settings["turn_timeout"] %>" inputmode="numeric"></label>
            <label>tool_timeout (s)<input type="text" name="tool_timeout" value="<%= @settings["tool_timeout"] %>" inputmode="numeric"></label>
          </div>
        </form>
      </div>

    <% elsif @section == "models" %>
      <div class="drill-pane-head">
        <div class="title"><strong>Model defaults</strong></div>
        <button type="submit" form="set-models" class="btn primary" data-turbo-submits-with="Saving…">Save</button>
      </div>
      <div class="drill-pane-body">
        <p class="muted">The platform model layer, resolved at turn start as <strong>Chat pin › Agent model › platform default</strong>. An agent with no model of its own inherits <code>default_model</code>.</p>
        <form id="set-models" method="post" action="/studio/settings/models">
          <%== csrf_tag %>
          <div class="grid-2">
            <label>default_model <span class="muted">(agents without their own model)</span><input type="text" name="default_model" value="<%= @settings["default_model"] %>" placeholder="deepseek-v4-flash"></label>
            <label>default_provider <span class="muted">(optional)</span><input type="text" name="default_provider" value="<%= @settings["default_provider"] %>" placeholder="deepseek"></label>
          </div>
          <label>fallback_models <span class="muted">(ordered chain; <code>provider/model</code> or <code>model</code>, comma or newline)</span><input type="text" name="fallback_models" value="<%= Array(@settings["fallback_models"]).join(", ") %>" placeholder="deepseek/deepseek-v4-flash, openai/gpt-4o-mini"></label>
          <label>utility_model <span class="muted">(cheap internal tasks — titles, distillation)</span><input type="text" name="utility_model" value="<%= @settings["utility_model"] %>" placeholder="deepseek-v4-flash"></label>
          <label>reasoning <span class="muted">(global default — off/on/effort; blank = provider default)</span>
            <%== thinking_select("thinking", @settings["thinking"], "provider default") %>
          </label>
        </form>

        <hr>
        <p class="muted">Per-model reasoning defaults — the layer between global and agent (resolved <strong>Chat › Agent › Model › Global</strong>). One per line.</p>
        <form id="set-model-params" method="post" action="/studio/settings/model-params">
          <%== csrf_tag %>
          <label>model_params <span class="muted">(one per line: <code>provider/model | off|on|low|medium|high</code>)</span>
            <textarea name="model_params" rows="4" placeholder="deepseek/deepseek-v4-flash | off"><%= model_params_text(@settings["model_params"]) %></textarea>
          </label>
          <div class="actions"><button type="submit" class="btn primary" data-turbo-submits-with="Saving…">Save per-model</button></div>
        </form>
      </div>

    <% elsif @section == "edge" %>
      <div class="drill-pane-head">
        <div class="title"><strong>Edge limits</strong></div>
        <button type="submit" form="set-edge" class="btn primary" data-turbo-submits-with="Saving…">Save</button>
      </div>
      <div class="drill-pane-body">
        <p class="muted">The named place where volume/cost abuse is cut, <strong>before any LLM spend</strong>. Blank/0 = off (opt-in). A breached turn completes gracefully with the safe reply below. Per-agent overrides live in each agent's config.</p>
        <form id="set-edge" method="post" action="/studio/settings/edge">
          <%== csrf_tag %>
          <div class="grid-2">
            <label>chat_rate_limit <span class="muted">(turn attempts per chat per window)</span><input type="text" name="chat_rate_limit" value="<%= @settings.dig("edge", "chat_rate_limit") %>" inputmode="numeric" placeholder="off"></label>
            <label>chat_rate_window (s)<input type="text" name="chat_rate_window" value="<%= @settings.dig("edge", "chat_rate_window") %>" inputmode="numeric" placeholder="60"></label>
            <label>agent_token_ceiling <span class="muted">(total tokens per agent per window)</span><input type="text" name="agent_token_ceiling" value="<%= @settings.dig("edge", "agent_token_ceiling") %>" inputmode="numeric" placeholder="off"></label>
            <label>agent_token_window (s)<input type="text" name="agent_token_window" value="<%= @settings.dig("edge", "agent_token_window") %>" inputmode="numeric" placeholder="86400"></label>
          </div>
          <label>limit_response <span class="muted">(safe reply on breach; blank = neutral built-in)</span><input type="text" name="limit_response" value="<%= @settings.dig("edge", "limit_response") %>" placeholder="Estou recebendo muitas mensagens agora…"></label>
        </form>
      </div>

<% elsif @section == "evals" %>
  <div class="drill-pane-head">
    <div class="title"><strong>Evals</strong></div>
    <button type="submit" form="set-evals" class="btn primary" data-turbo-submits-with="Saving…">Save</button>
  </div>
  <div class="drill-pane-body">
    <p class="muted">Who grades a <a href="/studio/evals">case</a>'s rubric. <strong>One model per line</strong> as <code>provider/model</code> — several lines make a PANEL, and two different models disagreeing is the signal worth having (sampling one model N times mostly measures its own variance). Empty = deterministic assertions only, and rubric'd cases read as <code>judge_pending</code>.</p>
    <form id="set-evals" method="post" action="/studio/settings/evals">
      <%== csrf_tag %>
      <label>judges<textarea name="judges" rows="4" spellcheck="false" placeholder="deepseek/deepseek-v4-flash&#10;openai/gpt-5-mini"><%= Array(@settings.dig("evals", "judges")).map { |j| [j["provider"], j["model"]].compact.reject(&:empty?).join("/") }.join("\n") %></textarea></label>
      <div class="grid-2">
        <label>aggregate <span class="muted">(how the panel's scores combine)</span>
          <select name="aggregate">
            <% %w[median mean min].each do |k| %>
              <option value="<%= k %>"<%== ' selected' if @settings.dig("evals", "aggregate") == k %>><%= k %></option>
            <% end %>
          </select>
        </label>
        <label>min_agreement <span class="muted">(fraction that must pass; 1.0 = unanimous)</span><input type="text" name="min_agreement" value="<%= @settings.dig("evals", "min_agreement") %>" inputmode="decimal" placeholder="0.5"></label>
        <label>quorum <span class="muted">(samples per judge)</span><input type="text" name="quorum" value="<%= @settings.dig("evals", "quorum") %>" inputmode="numeric" placeholder="1"></label>
        <label>tolerance <span class="muted">(max score drop before it's a regression)</span><input type="text" name="tolerance" value="<%= @settings.dig("evals", "tolerance") %>" inputmode="decimal" placeholder="0.05"></label>
      </div>
    </form>
  </div>

    <% else %>
      <div class="drill-pane-head">
        <div class="title"><strong>LLM providers <span class="count"><%= @providers.size %></span></strong></div>
      </div>
      <div class="drill-pane-body">
        <p class="muted">Key/base/models per provider. The <code>api_key</code> never returns in plaintext — the field shows <code><%= secret_sentinel %></code> when a key is saved; resubmitting untouched preserves it, clearing removes it. Applied at runtime (no restart).</p>
        <% @providers.each do |p| %>
          <div class="card promptfile">
            <div class="promptfile-head">
              <strong class="mono"><%= p["api"] %></strong>
              <form method="post" action="/studio/settings/providers/delete" data-turbo-confirm="Remove provider &quot;<%= p["api"] %>&quot;?">
                <%== csrf_tag %>
                <input type="hidden" name="api" value="<%= p["api"] %>">
                <button type="submit" class="ghost danger" data-turbo-submits-with="Removing…">Remove</button>
              </form>
            </div>
            <form method="post" action="/studio/settings/providers">
              <%== csrf_tag %>
              <input type="hidden" name="api" value="<%= p["api"] %>">
              <div class="grid-2">
                <label>base_url<input type="text" name="base_url" value="<%= p["base_url"] %>" placeholder="https://api.deepseek.com/v1"></label>
                <label>auth_header<input type="text" name="auth_header" value="<%= p["auth_header"] %>" placeholder="Authorization"></label>
              </div>
              <label>api_key<input type="password" name="api_key" value="<%= p["api_key"] %>" autocomplete="off"></label>
              <label>models <span class="muted">(comma or newline)</span><input type="text" name="models" value="<%= Array(p["models"]).join(", ") %>" placeholder="deepseek-v4-flash, deepseek-reasoner"></label>
              <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Saving…">Save provider</button></div>
            </form>
          </div>
        <% end %>

        <details class="card newfile"<%== " open" if @providers.empty? %>>
          <summary>+ new provider</summary>
          <form method="post" action="/studio/settings/providers">
            <%== csrf_tag %>
            <div class="grid-2">
              <label>api <span class="muted">(slug, e.g. deepseek)</span><input type="text" name="api" placeholder="openai" required></label>
              <label>base_url<input type="text" name="base_url" placeholder="https://api.openai.com/v1"></label>
            </div>
            <label>auth_header<input type="text" name="auth_header" placeholder="Authorization"></label>
            <label>api_key<input type="password" name="api_key" autocomplete="off" placeholder="sk-…"></label>
            <label>models <span class="muted">(comma or newline)</span><input type="text" name="models" placeholder="gpt-4o, gpt-4o-mini"></label>
            <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Creating…">Create provider</button></div>
          </form>
        </details>
      </div>
    <% end %>
  </section>
</div>
