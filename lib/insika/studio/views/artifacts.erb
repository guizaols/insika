<div class="reports-page reports-artifacts">
<%# the Artifacts page: the report destination. Reads the ArtifactStore
   directly (the listing IS the history); the only mutation — delete —
   dispatches :delete_artifact on the bus. The preview is a sandboxed iframe
   on top of the content route's own restrictive CSP. %>
<header class="page-head">
  <div>
    <%== crumbs_for("Artifacts") %>
    <h1>Artifacts<span class="sub">Saved reports & pages</span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/artifacts", @agent) %>
  </div>
</header>

<% if @artifacts.empty? %>
  <div class="empty">
    <% if @agent %>
      No artifacts for <span class="mono"><%= @agent %></span> — an agent that
      has <span class="mono">save_artifact</span> in its <span class="mono">tools_allow</span>
      writes its reports here.
    <% else %>
      No artifacts yet. Reports appear here when an agent uses <code>save_artifact</code>.
    <% end %>
  </div>
<% else %>
  <div class="section-head"><h2>Saved artifacts</h2><span class="muted"><%= @artifacts.size %> reports · newest first</span></div>
  <div class="card report-table">
    <table class="grid">
      <thead>
        <tr>
          <% unless @agent %><th>agent</th><% end %>
          <th>Title</th><th>Format</th><th>Task</th><th class="time">Created</th><th><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @artifacts.each do |a| %>
          <tr>
            <% unless @agent %>
              <td><%== render("_identity", locals: { id: a.agent, name: a.agent, sub: nil }) %></td>
            <% end %>
            <td class="ellipsis"><a href="/studio/artifacts/<%= Rack::Utils.escape_path(a.id) %>"><%= a.title %></a></td>
            <td><span class="status neutral"><%= a.mime %></span></td>
            <td class="mono"><span title="<%= a.task_id %>" data-copy="<%= a.task_id %>"><%= short_id(a.task_id) %></span></td>
            <td class="time"><span title="<%= a.created_at %>"><%= time_ago(a.created_at) %></span></td>
            <td class="row-actions">
              <% if @signed_available %>
                <button type="button" class="btn ghost btn-sm" data-copy="<%= signed_artifact_url(a.id) %>">copy link</button>
              <% end %>
              <form method="post" action="/studio/artifacts/<%= Rack::Utils.escape_path(a.id) %>/delete"
                    class="inline" data-turbo-confirm="Delete this artifact?">
                <%== csrf_tag %>
                <input type="hidden" name="agent" value="<%= a.agent %>">
                <button class="btn ghost btn-sm danger">delete</button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

</div>
