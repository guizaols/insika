<%# the Facts (wiki) page — the human gate on distilled proposals.
   Nothing is ever applied automatically: each pending fact needs a click.
   Console shell: one queue (pending, then stale, then recent) on the left,
   the selected fact's evidence + actions on the right — see _facts_master.erb
   and fact_detail.erb for the shared miller-column pieces. Reads
   ProposalStore + SessionStore directly (evidence is a link, never a
   copy — D7); the approve/reject/dismiss mutations dispatch :resolve_proposal
   on the bus. %>
<header class="page-head">
  <div>
    <%== crumbs_for("Facts") %>
    <h1>Facts<span class="sub">distilled customer facts, human-gated</span></h1>
  </div>
  <div class="head-actions">
    <form method="get" action="/studio/facts" class="actions inline">
      <label>
        Agent / scope
        <select name="agent" data-controller="auto-submit" data-action="change->auto-submit#submit">
          <option value="">all</option>
          <% @stores.each do |scope| %>
            <option value="<%= scope %>"<%== ' selected' if scope == @filter %>><%= scope %></option>
          <% end %>
        </select>
      </label>
    </form>
  </div>
</header>

<% if insika[:proposal_store].nil? %>
  <%== render("_empty", locals: { icon: :facts,
                                  text: "Distillation is off — nothing distills until an agent declares a distill: block in its pack." }) %>
<% else %>
  <div class="drill" data-controller="list-filter">
    <%== render("_facts_master", locals: { active_id: @selected&.id }) %>
    <%== render("fact_detail", locals: { frame_only: true }) %>
  </div>
<% end %>
