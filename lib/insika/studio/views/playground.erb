<%# Playground — chat surface (T4): config bar on top, transcript scrolls, composer
   pinned at the bottom. Same form fields/route + live-transcript targets as before;
   fires the same send_message as the API. %>
<div class="chat"
     data-controller="live-transcript"
     data-live-transcript-session-value="<%= @session_id %>">
  <form class="chat-form" method="post" action="/studio/playground">
    <%== csrf_tag %>
    <div class="chat-head">
      <label class="chat-field">agent
        <select name="agent">
          <% @agents.each do |id| %>
            <option value="<%= id %>"<%== ' selected' if id == @agent %>><%= id %></option>
          <% end %>
        </select>
      </label>
      <label class="chat-field">session
        <input type="text" name="session_id" value="<%= @session_id %>" placeholder="empty = new conversation">
      </label>
      <span class="pill info chat-status" data-live-transcript-target="status">disconnected</span>
      <details class="pin chat-pin">
        <summary>overrides <span class="muted">— pin a NEW conversation (Chat › Agent › Model › platform)</span></summary>
        <div class="row">
          <label>model<input type="text" name="model" placeholder="leave empty = agent/platform default"></label>
          <label>provider<input type="text" name="provider" placeholder="optional"></label>
          <label>reasoning<%== thinking_select("thinking", nil, "agent/platform default") %></label>
        </div>
      </details>
    </div>

    <div class="chat-thread">
      <div class="thread" data-live-transcript-target="stream">
        <% Array(@history).each_with_index do |m, i| %><%== render("_message", locals: { m: m, prev: i.positive? ? @history[i - 1] : nil }) %><% end %>
        <% if @sent_message %><%== render("_message", locals: { m: { "role" => "user", "content" => @sent_message, "at" => nil }, prev: nil }) %><% end %>
      </div>
      <div class="empty chat-empty" data-live-transcript-target="empty"<%== ' hidden' unless Array(@history).empty? && @sent_message.nil? %>>
        <% if @session_id %>Waiting for turn events…<% else %>Send a message to begin a conversation.<% end %>
      </div>
    </div>

    <div class="chat-composer">
      <textarea name="message" rows="1" placeholder="Ask the agent something…" required
                aria-label="message"></textarea>
      <button type="submit" class="primary" data-turbo-submits-with="Sending…">Send</button>
    </div>
  </form>
</div>
