<!DOCTYPE html>
<html lang="en" data-theme="<%= theme_pref %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Turbo 8 Drive routes same-origin visits through the View Transitions API
      when this meta is present; browsers without support degrade
      to the plain swap. The CSS owns the actual transition (application.css,
      ::view-transition-*), including the prefers-reduced-motion kill switch. %>
  <meta name="view-transition" content="same-origin">
  <meta name="csp-nonce" content="<%= csp_nonce %>">
  <title>Insika Studio</title>
  <link rel="icon" type="image/svg+xml" href="<%= asset_path("favicon.svg") %>">
  <%# The two webfonts every page uses on first paint (body sans + mono at 400).
      Without the preload the browser only discovers them after the stylesheet
      parses, which is one round-trip of fallback text. The other mono weights
      are rare enough to stay lazy. The hrefs must match the @font-face `src:`
      in application.css exactly — see font_path in app.rb. %>
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="<%= font_path("ibm-plex-sans-latin-wght-normal.woff2") %>">
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="<%= font_path("ibm-plex-mono-latin-400-normal.woff2") %>">
  <%# data-turbo-track="reload": after a deploy the ?v= changes, and a Turbo
      visit from a tab opened before it must reload the page — merging the
      new head would run a SECOND application.js next to the old one, and
      every controller (live transcript included) would connect twice. %>
  <link rel="stylesheet" href="<%= asset_path("application.css") %>" data-turbo-track="reload">
  <script type="module" src="<%= asset_path("application.js") %>" defer data-turbo-track="reload"></script>
</head>
<body>
  <%# Chip-icon sprite: one source of truth for transcript event
      chips — the ERB partial renders chip_icon() from the same nav_icons.rb set,
      and live_transcript_controller.js clones from this template, so live and
      replayed transcripts can never drift apart. %>
  <template id="chip-icons" aria-hidden="true">
    <% Studio::NavIcons::CHIP_ICONS.each do |kind, icon| %>
      <span data-kind="<%= kind %>" class="chip-ic"><%== nav_icon(icon) %></span>
    <% end %>
  </template>
  <% if authenticated? %>
    <div class="app-shell" data-controller="palette">
      <aside class="sidebar">
        <a class="brand" href="/studio/home"><span class="dot"></span>Insika <small>Studio</small></a>
        <button type="button" class="palette-open" data-action="palette#open">
          <%== nav_icon(:search) %><span>Search</span><kbd>⌘K</kbd>
        </button>

        <% nav_sections.each do |group, items| %>
          <div class="nav-group">
            <% unless group.empty? %><div class="nav-label"><%= group %></div><% end %>
            <nav class="nav" aria-label="<%= group %>">
              <% items.each do |label, href, icon, count| %>
                <a href="<%= href %>"<%== ' aria-current="page"' if nav_active?(href) %>>
                  <%== nav_icon(icon) %><span class="lbl"><%= label %></span>
                  <% if count.to_i.positive? %><span class="nav-badge" aria-label="<%= count %> pending"><%= count %></span><% end %>
                </a>
              <% end %>
            </nav>
          </div>
        <% end %>

        <div class="sidebar-foot">
          <div class="health-card">
            <div class="row"><span class="pill ok online plain">runtime online</span></div>
            <div class="stat">
              <% health_parts.each do |label, value| %>
                <span class="stat-row"><b><%= value %></b> <%= label %></span>
              <% end %>
            </div>
          </div>
          <div class="foot-actions">
            <div class="theme-switch" data-controller="theme" role="group" aria-label="theme">
              <% { "auto" => "auto", "light" => "light", "dark" => "dark" }.each do |val, label| %>
                <button type="button" class="theme-opt" data-theme-target="opt"
                        data-theme-value-param="<%= val %>" data-action="theme#set"><%= label %></button>
              <% end %>
            </div>
            <form class="logout" method="post" action="/studio/logout">
              <%== csrf_tag %>
              <button type="submit" class="ghost">Sign out</button>
            </form>
          </div>
        </div>
      </aside>

      <div class="app-main">
        <% if (env = env_banner) %>
          <div class="env-banner <%= env[:kind] %>" role="status">
            <b><%= env[:label] %></b><span>Not production — changes here never reach customers.</span>
          </div>
        <% end %>
        <% if flash["error"] %>
          <div class="flash err" role="alert"><%= flash["error"] %></div>
        <% end %>
        <% if flash["notice"] %>
          <div class="flash ok" role="status"><%= flash["notice"] %></div>
        <% end %>

        <main class="page">
          <%== yield %>
        </main>
      </div>

      <%# ⌘K palette: every page and agent, filtered client-side (list-filter). %>
      <dialog class="palette" data-palette-target="dialog" data-controller="list-filter" aria-label="Jump to">
        <input type="text" class="palette-query" autocomplete="off" placeholder="Jump to a page or agent…" aria-label="Jump to"
               data-palette-target="query" data-list-filter-target="query"
               data-action="input->list-filter#filter input->palette#reset keydown->palette#key">
        <div class="palette-list" role="listbox">
          <% palette_entries.each do |group, label, href| %>
            <a href="<%= href %>" role="option" data-palette-target="item" data-list-filter-target="item"
               data-filter-text="<%= group %> <%= label %>" data-action="click->palette#close">
              <span><%= label %></span><small><%= group %></small>
            </a>
          <% end %>
          <div class="palette-empty" data-list-filter-target="empty" hidden>No match.</div>
        </div>
      </dialog>
    </div>
  <% else %>
    <% if flash["error"] %>
      <div class="flash err" role="alert"><%= flash["error"] %></div>
    <% end %>
    <main class="page auth-page">
      <%== yield %>
    </main>
  <% end %>
</body>
</html>
