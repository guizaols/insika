<%# Tools — drill-down (T2): [data tools + agents] master | agent tool matrix.
   @sel_agent (from ?a=) drives the detail; data tools link to their editor page. %>
<div class="drill" data-controller="list-filter">
  <aside class="drill-pane drill-master">
    <div class="drill-pane-head">
      <div class="title"><strong>Tools <span class="count"><%= @tools.size %></span></strong></div>
      <a class="btn primary btn-sm" href="/studio/tools/def/new">+ data tool</a>
    </div>
    <div class="drill-search">
      <input type="search" class="filter-input" placeholder="Filter agents…" aria-label="Filter agents"
             data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
    </div>
    <nav class="drill-pane-body drill-list" aria-label="tools and agents">
      <% unless @data_tool_names.empty? %>
        <div class="drill-group-label">Data tools · HTTP, editable</div>
        <% @data_tool_names.sort.each do |name| %>
          <% dropped = @dropped_tool_names.include?(name) %>
          <a class="drill-item drill-item-sm" href="/studio/tools/def/<%= Rack::Utils.escape(name) %>"
             <%== %( title="its definition is invalid — no agent can call it until it is fixed") if dropped %>>
            <div class="drill-item-name"><span class="txt"><%= name %></span><span class="pill plain">data</span><% if dropped %> <span class="pill locked">dropped</span><% end %></div>
          </a>
        <% end %>
      <% end %>
      <div class="drill-group-label">Agents · allow / deny</div>
      <% @agents.each do |a| %>
        <a class="drill-item<%== ' active' if @sel_agent && @sel_agent.id == a.id %>"
           href="/studio/tools?a=<%= Rack::Utils.escape(a.id) %>"
           data-list-filter-target="item" data-filter-text="<%= a.id %>">
          <div class="drill-item-name"><span class="txt"><%= a.id %></span>
            <span class="pill plain"><%= a.tools_allow.nil? ? "all" : "#{tools_on_count(a, @tools)}/#{@tools.size}" %></span>
          </div>
        </a>
      <% end %>
      <div class="empty" data-list-filter-target="empty" hidden>No agents match your filter.</div>
    </nav>
  </aside>

  <section class="drill-pane drill-detail">
    <% if @sel_agent.nil? %>
      <div class="drill-empty">
        <div>
          <h2>Tools</h2>
          <p>Pick an agent to set which tools it can call — or edit a data tool on the left. <strong>all</strong> = open allowlist (every tool flows through); a <span class="pill locked">locked</span> tool is on the denylist (deny always wins).</p>
        </div>
      </div>
    <% else %>
      <% a = @sel_agent %>
      <div class="drill-pane-head">
        <div class="title">
          <strong class="mono"><%= a.id %></strong>
        </div>
        <button type="submit" form="tools-form" class="btn primary" data-turbo-submits-with="Saving…">Save tools</button>
      </div>
      <div class="drill-pane-body" data-controller="toggle-counter">
        <div class="matrix-topline">
          <span class="count-badge mono" data-toggle-counter-target="count"><%= a.tools_allow.nil? ? "all" : "#{tools_on_count(a, @tools)}/#{@tools.size} on" %></span>
          <label class="switch" title="open allowlist — every tool flows through">
            <input type="checkbox" name="all_tools" value="1" form="tools-form"<%== " checked" if a.tools_allow.nil? %>
                   data-toggle-counter-target="all" data-action="change->toggle-counter#update">
            <span class="switch-track" aria-hidden="true"></span>
            <span class="switch-label">all tools</span>
          </label>
        </div>
        <p class="muted">Checked tools are allowed next turn. A <span class="pill locked">locked</span> tool is on the denylist — deny always wins, so it can't be granted here.</p>
        <form id="tools-form" method="post" action="/studio/tools/<%= Rack::Utils.escape(a.id) %>">
          <%== csrf_tag %>
          <% if @tools.empty? %>
            <p class="muted">No tools registered in the runtime.</p>
          <% else %>
            <div class="check-grid tool-grid<%== " is-open" if a.tools_allow.nil? %>" data-toggle-counter-target="grid">
              <% @tools.each do |t| %>
                <% denied = tool_denied_for?(a, t.name) %>
                <label class="check tool-check<%== " locked" if denied %>" title="<%= denied ? "denied — deny wins" : t.description %>">
                  <input type="checkbox" name="tools[]" value="<%= t.name %>"
                         <%== " checked" if tool_allowed_for?(a, t.name) && !denied %>
                         <%== " disabled" if denied %>
                         data-toggle-counter-target="tool" data-locked="<%= denied %>"
                         data-action="change->toggle-counter#update">
                  <span class="mono"><%= t.name %></span><% if @data_tool_names.include?(t.name) %> <span class="pill plain">data</span><% end %><% if denied %> <span class="pill locked">locked</span><% end %>
                </label>
              <% end %>
            </div>
          <% end %>
        </form>
      </div>
    <% end %>
  </section>
</div>
