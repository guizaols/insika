<%# Tools — the catalog, as miller columns: every tool in the master (grouped by
    origin, searchable, with how many agents can call it) | the detail in a
    turbo-frame: a data tool's editor, or a read-only card for code and MCP
    tools. Which agent may call what lives on the agent (its Tools tab).
    @detail: nil (landing) | :edit (data-tool editor) | :info (read-only card). %>
<% frame_only = defined?(frame_only) && frame_only %>
<% unless frame_only %>
<header class="page-head">
  <h1>Tools<span class="sub">Every tool agents can call — edit HTTP tools, see who uses each one</span></h1>
</header>
<div class="drill" data-controller="list-filter">
  <aside class="drill-pane drill-master">
    <div class="drill-pane-head">
      <div class="title"><strong>Tools <span class="count" data-list-filter-target="count"><%= @tools.size %></span></strong></div>
      <a class="btn primary btn-sm" href="/studio/tools/def/new" data-turbo-frame="tool-detail" data-turbo-action="advance">+ New tool</a>
    </div>
    <div class="drill-search">
      <input type="search" class="filter-input" placeholder="Search tools…" aria-label="Search tools"
             data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
      <label class="switch" title="show only tools no agent can call">
        <input type="checkbox" id="only-unused">
        <span class="switch-track" aria-hidden="true"></span>
        <span class="switch-label">only unused</span>
      </label>
    </div>
    <nav class="drill-pane-body drill-list" aria-label="tools" data-controller="active-link">
      <% @tool_groups.each do |label, tools| %>
        <details class="drill-group" data-list-filter-target="group"<%== " open" unless label.start_with?("MCP") %>>
          <summary class="drill-group-label"><%= label %> <span class="count"><%= tools.size %></span></summary>
          <% tools.each do |t| %>
            <% data = @data_tool_names.include?(t.name) %>
            <% users = @tool_reach[t.name].size %>
            <a class="drill-item drill-item-sm<%== ' active' if @selected == t.name %>"
               href="/studio/tools/<%= data ? "def" : "info" %>/<%= Rack::Utils.escape(t.name) %>"<%== " data-unused" if users.zero? %>
               data-turbo-frame="tool-detail" data-turbo-action="advance"
               data-list-filter-target="item" data-filter-text="<%= "#{t.name} #{label}" %>"
               data-active-link-target="item" data-action="click->active-link#select" title="<%= t.description %>">
              <div class="drill-item-name"><span class="txt"><%= t.name %></span><% if data %><span class="pill plain">data</span><% end %><span class="pill <%= users.zero? ? "warn" : "plain" %>"><%= users %> <%= users == 1 ? "agent" : "agents" %></span></div>
            </a>
          <% end %>
        </details>
      <% end %>
      <% if @dropped_tool_names.any? %>
        <details class="drill-group" data-list-filter-target="group" open>
          <summary class="drill-group-label">Invalid definitions <span class="count"><%= @dropped_tool_names.size %></span></summary>
          <% @dropped_tool_names.sort.each do |name| %>
            <a class="drill-item drill-item-sm" href="/studio/tools/def/<%= Rack::Utils.escape(name) %>"
               data-turbo-frame="tool-detail" data-turbo-action="advance"
               data-list-filter-target="item" data-filter-text="<%= name %>"
               title="its definition is invalid — no agent can call it until it is fixed">
              <div class="drill-item-name"><span class="txt"><%= name %></span><span class="pill locked">dropped</span></div>
            </a>
          <% end %>
        </details>
      <% end %>
      <div class="empty" data-list-filter-target="empty" hidden>No tools match your search.</div>
    </nav>
  </aside>
<% end %>
  <turbo-frame id="tool-detail" class="drill-pane drill-detail">
    <% if frame_only %>
      <% if flash["error"] %><div class="flash err" role="alert"><%= flash["error"] %></div><% end %>
      <% if flash["notice"] %><div class="flash ok" role="status"><%= flash["notice"] %></div><% end %>
    <% end %>
    <% case @detail %>
    <% when :edit %>
      <%== render("_tool_edit") %>
    <% when :info %>
      <% t = @info_tool %>
      <div class="drill-pane-head">
        <div class="title">
          <strong class="mono"><%= t.name %></strong>
          <span class="count"><%= @info_label %></span>
        </div>
      </div>
      <div class="drill-pane-body">
        <p><%= t.description %></p>
        <p class="muted"><%= t.plugin.to_s.start_with?("mcp:") ? "Comes from an MCP server; edit the server under MCP." : "Built into the engine; it cannot be edited here." %></p>
        <%== render("_tool_users", locals: { name: t.name }) %>
      </div>
    <% else %>
      <div class="drill-empty">
        <div>
          <h2>Tools</h2>
          <p>Pick a tool to see which agents can call it. HTTP tools open their editor; MCP and built-in tools are read-only. Which tools an agent may call is set on the agent, in its <strong>Tools</strong> tab.</p>
        </div>
      </div>
    <% end %>
  </turbo-frame>
<% unless frame_only %>
</div>
<% end %>
