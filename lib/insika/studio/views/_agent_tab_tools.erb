<!-- ── Agent tools ───────────────────────────────────────────────────────── -->
<%# The agent's tool access. It reads the agent's OWN record (@agent_own): kit
    tools render on and locked, never posted, so a save never copies them in. %>
<section class="section" id="tools" data-tabs-target="panel">
  <div class="section-head">
    <h2>Tools</h2>
    <p class="muted">Choose which tools this agent may call. Save tools applies this selection to <strong><%= @agent.id %></strong> on its next turn. A <span class="pill locked">locked</span> tool is on the denylist — deny always wins.</p>
  </div>
  <%# loading="lazy": the frame fetches when the tab is first shown. %>
  <turbo-frame id="agent-tools" src="/studio/agents/<%= Rack::Utils.escape(@agent.id) %>/tools" loading="lazy">
    <div class="card"><p class="muted">Loading…</p></div>
  </turbo-frame>
</section>
