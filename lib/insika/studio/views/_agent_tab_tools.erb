<!-- ── Agent tools ───────────────────────────────────────────────────────── -->
<%# The agent's tool access. It reads the agent's OWN record (@agent_own): kit
    tools render on and locked, never posted, so a save never copies them in. %>
<% a = @agent_own %>
<section class="section" id="tools" data-tabs-target="panel">
  <div class="section-head">
    <h2>Tools</h2>
    <p class="muted">Choose which tools this agent may call. Save tools applies this selection to <strong><%= a.id %></strong> on its next turn. A <span class="pill locked">locked</span> tool is on the denylist — deny always wins.</p>
  </div>
  <div class="card only-on-scope" data-controller="toggle-counter list-filter">
    <div class="matrix-topline">
      <span class="count-badge mono" data-toggle-counter-target="count"><%= a.tools_allow.nil? ? "all" : "#{tools_on_count(a, @tools)}/#{@tools.size} on" %></span>
      <label class="switch" title="open allowlist — every tool flows through">
        <input type="checkbox" name="all_tools" value="1" form="tools-form"<%== " checked" if a.tools_allow.nil? %>
               data-toggle-counter-target="all" data-action="change->toggle-counter#update">
        <span class="switch-track" aria-hidden="true"></span>
        <span class="switch-label">all tools</span>
      </label>
      <button type="button" class="btn ghost btn-sm" data-action="click->toggle-counter#selectNone"
              title="uncheck every tool (deny-all — Save tools to apply)">none</button>
      <label class="switch" title="hide tools this agent cannot call; typing a search shows every match">
        <input type="checkbox" id="only-on" checked>
        <span class="switch-track" aria-hidden="true"></span>
        <span class="switch-label">only enabled</span>
      </label>
    </div>
    <% open_all = a.tools_allow.nil? && a.tools_allow_groups.nil? %>
    <% kit_tools = open_all ? {} : kit_sources(a, "tools") %>
    <% if Array(a.kits).any? %>
      <% kit_links = a.kits.map { |k| %(<a class="pill info" href="/studio/kits/#{Rack::Utils.escape(k)}" data-turbo-frame="_top">#{h(k)}</a>) }.join(" ") %>
      <% if open_all %>
        <p class="muted">Its kits <%== kit_links %> add nothing here: this agent already gets every tool. Turn off <strong>all tools</strong> to limit it to its own list plus its kits.</p>
      <% else %>
        <p class="muted">Tools marked <span class="pill info">kit</span> come from its kits <%== kit_links %> and are edited there.</p>
      <% end %>
    <% end %>
    <input type="search" class="filter-input" placeholder="Search to add tools…" aria-label="Search tools or servers"
           data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
    <p class="empty" data-list-filter-target="empty" hidden>No tools match your filter.</p>
    <form id="tools-form" method="post" action="/studio/agents/<%= Rack::Utils.escape(a.id) %>/tools" data-controller="dirty-guard">
      <%== csrf_tag %>
      <% if @tools.empty? %>
        <p class="muted">No tools registered in the runtime.</p>
      <% else %>
        <div class="tool-grid<%== " is-open" if a.tools_allow.nil? %>" data-toggle-counter-target="grid">
          <% @tool_groups.each do |label, tools| %>
            <details class="tool-section" aria-label="<%= label %>" data-list-filter-target="group" open>
              <summary><%= label %> <span class="count"><%= tools_on_count(a, tools) + tools.count { |t| kit_tools[t.name] && !tool_allowed_for?(a, t.name) && !tool_denied_for?(a, t.name) } %>/<%= tools.size %></span></summary>
              <div class="matrix-topline">
                <button type="button" class="btn ghost btn-sm" data-action="click->toggle-counter#selectSection" data-checked="true"
                        aria-label="Select all tools in <%= label %>">Select all</button>
                <button type="button" class="btn ghost btn-sm" data-action="click->toggle-counter#selectSection" data-checked="false"
                        aria-label="Deselect all tools in <%= label %>">Deselect all</button>
              </div>
              <div class="check-grid tool-grid">
                <% tools.each do |t| %>
                  <% denied = tool_denied_for?(a, t.name) %>
                  <% from_kit = !denied && !tool_allowed_for?(a, t.name) && kit_tools[t.name] %>
                  <label class="check tool-check<%== " locked" if denied %>" title="<%= denied ? "denied — deny wins" : from_kit ? "from kit #{from_kit}" : t.description %>"
                         data-list-filter-target="item" data-filter-text="<%= "#{label} #{t.name}" %>">
                    <input type="checkbox" name="tools[]" value="<%= t.name %>"
                           <%== " checked" if (tool_allowed_for?(a, t.name) && !denied) || from_kit %>
                           <%== " disabled" if denied || from_kit %>
                           data-toggle-counter-target="tool" data-locked="<%= denied || !!from_kit %>"
                           data-action="change->toggle-counter#update">
                    <span class="mono"><%= t.name %></span><% if @data_tool_names.include?(t.name) %> <span class="pill plain">data</span><% end %><% if denied %> <span class="pill locked">locked</span><% end %><% if from_kit %> <span class="pill info">kit</span><% end %>
                  </label>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
      <div class="actions">
        <button type="submit" class="primary" data-turbo-submits-with="Saving…">Save tools</button>
        <a class="btn ghost" href="/studio/tools" data-turbo-frame="_top">Tool catalog</a>
      </div>
    </form>
  </div>
</section>
