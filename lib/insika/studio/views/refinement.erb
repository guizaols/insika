<%# Refinement — miller columns: master run list | detail frame, scoped to
    one agent at a time via agent_filter_form (a run always belongs to one
    agent). A row click loads the detail beside the list (no full page load)
    and advances the URL. The detail pane defaults to the run that most needs
    a look — see render_refinement — and hosts the Run form in its head, since
    starting a run is an action on the CURRENTLY VIEWED agent. %>
<header class="page-head">
  <div>
    <%== crumbs_for("Refinement") %>
    <h1>Refinement<span class="sub"><%= @agent || "no agent" %></span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/refinement", @agent) %>
    <a class="btn" href="/studio/chats">Open chats</a>
  </div>
</header>

<% if @agents.empty? %>
  <div class="empty">No agents yet. Create one first — a refinement run reads an agent's own traffic.</div>
<% else %>
  <div class="drill" data-controller="list-filter">
    <%== render("_refinement_master", locals: { active_id: @selected&.id }) %>
    <%== render("refinement_detail", locals: { frame_only: true }) %>
  </div>
<% end %>
