<%# Overview home: KPI strip + activity chart + recent
    conversations, all LIVE over the existing SSE channel (live_home_controller
    subscribes to /studio/events; the server-rendered numbers are its baseline).
    Charts are inline SVG (geometry via attributes, fill via stylesheet —
    CSP-safe, no inline style). %>
<div class="reports-page reports-home" data-controller="live-home" data-live-home-active-value="<%= @active_now %>">
  <header class="page-head">
    <div>
      <%== crumbs_for("Overview") %>
      <h1>Overview<span class="sub">Conversations & activity</span></h1>
    </div>
    <div class="head-actions">
      <%== agent_filter_form("/studio/home", @agent) %>
      <%# "active now" — conversations touched in the last 5 minutes (the same
          number render_home computes). The ring spins while anything is hot;
          the ago label tracks the last event the page has seen. %>
      <span class="live-badge<%= @active_now.positive? ? " hot" : "" %>" title="conversations touched in the last 5 minutes">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle class="ring" cx="8" cy="8" r="6.5"/></svg>
        <b class="tnum" data-live-home-target="count"><%= @active_now %></b> active now
        <span class="live-ago muted" data-live-home-target="ago"></span>
      </span>
      <a class="btn primary" href="/studio/playground">Open playground</a>
    </div>
  </header>

  <%# home-ops: everything below the header. live-home reloads this frame
      (debounced) when a turn ends, so the numbers follow the traffic. %>
  <turbo-frame id="home-ops" target="_top" data-live-home-target="ops">
  <% totals = @day && @day["totals"] %>
  <% turns = @day && @day["turns"] %>
  <% p95 = turns && turns["windows"]["total_ms"]["p95"] %>
  <% cost = totals && totals["cost"] %>
  <div class="kpi-strip">
    <% window = "last 14 days" %>
    <% [["Conversations", @counts["conversations"], @conv_trend, (window if @agent)],
        ["Messages", @counts["messages"], @msg_trend, window],
        ["Outcomes", @outcomes_24h || "—", nil, "last 24h"],
        ["Cost", usd(cost), nil, @day_before_cost.nil? ? "last 24h" : "last 24h · #{usd(@day_before_cost)} before"],
        ["Turn p95", p95.nil? ? "—" : format("%.1fs", p95 / 1000.0), nil, turns ? "#{turns['count']} turns · 24h" : "last 24h"],
        ["Failed turns", turns && turns["count"].positive? ? format("%.1f%%", turns["failures"] * 100.0 / turns["count"]) : "—", nil, turns ? "#{turns['failures']} in 24h" : "last 24h"]].each do |label, value, trend, sub| %>
      <% delta = (trend && !trend.zero?) ? "#{trend.positive? ? '+' : '-'}#{trend.abs}" : nil %>
      <%== render("_kpi", locals: { label: label, value: value, delta: delta, sub: sub }) %>
    <% end %>
  </div>

  <p class="report-note">Every number follows the agent filter. Conversations and messages compare today with yesterday; cost, outcomes and turns cover the last 24 hours. <a href="/studio/models<%= "?agent=#{Rack::Utils.escape(@agent)}" if @agent %>">Models</a> has the detail.</p>

  <div class="home-grid">
    <section class="card home-activity">
      <div class="section-head">
        <h2>Activity</h2>
        <span class="muted">conversations touched · last 14 days</span>
      </div>
      <%# 24h sparkline: area-fill + 1.5px line over the hourly series, on the
          shared .chart base (Task 1) — same hairline axis and sans labels as
          the funnel's bar chart, just a line/time-series shape instead of
          bars. Geometry via attributes, colors via classes — CSP-safe. %>
      <% s_max = [@activity_24h.map(&:last).max || 0, 1].max %>
      <% s_n = @activity_24h.size %>
      <% s_pts = @activity_24h.each_with_index.map do |(_t, c), i|
           [i * (480.0 / (s_n - 1)), 44.0 - (c.to_f / s_max) * 36.0]
         end %>
      <% s_line = s_pts.map { |x, y| format("%.1f,%.1f", x, y) }.join(" ") %>
      <div class="sparkline-strip">
        <div class="sparkline-meta">
          <b class="tnum"><%= @activity_24h.sum { |_t, c| c } %></b> conversations · last 24h
        </div>
        <svg class="chart chart-sparkline" viewBox="0 0 480 48" preserveAspectRatio="none" role="img"
             aria-label="conversations per hour, last 24 hours">
          <polygon class="spark-area" points="<%= s_line %> 480,48 0,48"/>
          <polyline class="spark-line" points="<%= s_line %>" vector-effect="non-scaling-stroke"/>
          <line class="axis" x1="0" y1="44" x2="480" y2="44" />
        </svg>
        <div class="chart-labels">
          <span><%= @activity_24h.first&.first&.strftime('%-l%P') %></span>
          <span>now</span>
        </div>
      </div>
      <% max = [@activity.map(&:last).max || 0, 1].max %>
      <svg class="barchart" viewBox="0 0 700 176" preserveAspectRatio="none" role="img" aria-label="conversations per day, last 14 days">
        <% n = @activity.size; slot = 700.0 / n; bw = slot * 0.58 %>
        <% @activity.each_with_index do |(d, c), i| %>
          <% h = (c.to_f / max) * 150.0; x = (i * slot) + ((slot - bw) / 2.0); y = 160.0 - h %>
          <rect class="bar<%== ' bar-empty' if c.zero? %>" x="<%= format('%.1f', x) %>" y="<%= format('%.1f', c.zero? ? 157.0 : y) %>"
                width="<%= format('%.1f', bw) %>" height="<%= format('%.1f', c.zero? ? 3.0 : [h, 3.0].max) %>" rx="2">
            <title><%= d.strftime('%b %-d') %> · <%= c %> conversation<%= 's' unless c == 1 %></title>
          </rect>
        <% end %>
        <line class="barchart-axis-line" x1="0" y1="160" x2="700" y2="160" />
      </svg>
      <div class="barchart-axis">
        <span><%= @activity.first&.first&.strftime('%b %-d') %></span>
        <span class="peak">peak <%= max %>/day</span>
        <span><%= @activity.last&.first&.strftime('%b %-d') %></span>
      </div>
    </section>

    <section class="card home-recent">
      <div class="section-head">
        <h2>Recent conversations</h2>
        <a class="muted" href="/studio/chats<%= "?agent=#{Rack::Utils.escape(@agent)}" if @agent %>">See all</a>
      </div>
      <% cutoff = Time.now - (5 * 60) %>
      <ul class="convo-rail" data-live-home-target="list">
        <% if @recent.empty? %>
          <li data-live-home-target="placeholder"><div class="empty">No conversations yet. Start one in the <a href="/studio/playground">playground</a>.</div></li>
        <% else %>
          <% @recent.each do |s| %>
            <% fresh = (t = parse_time(s.updated_at)) && t >= cutoff %>
            <li data-session-id="<%= s.id %>">
              <a href="/studio/sessions/<%= Rack::Utils.escape(s.id) %>">
                <span class="avatar sm <%= avatar_class(s.id) %>"><%= s.id[0, 2].upcase %></span>
                <span class="convo-main">
                  <span class="convo-id mono" title="<%= s.id %>"><%= s.id[0, 20] %></span>
                  <span class="convo-sub"><%= Array(s.messages).size %> msg · <%= time_ago(s.updated_at) %></span>
                </span>
                <span class="presence<%= " present" if fresh %>" title="touched in the last 5 minutes"></span>
              </a>
            </li>
          <% end %>
        <% end %>
      </ul>
    </section>
  </div>

  <div class="home-grid">
    <section class="card">
      <div class="section-head"><h2>Cost per day</h2><span class="muted">reported USD · tokens in the tooltip · UTC days</span></div>
      <% d_costs = @daily.map { |b| b["cost"] || 0 } %>
      <% if @daily.empty? || d_costs.sum.zero? %>
        <div class="empty">No reported cost in the last 14 days.</div>
      <% else %>
        <% d_max = [d_costs.max, 0.000001].max %>
        <svg class="barchart" viewBox="0 0 700 176" preserveAspectRatio="none" role="img" aria-label="reported cost per day, last 14 days">
          <% n = @daily.size; slot = 700.0 / n; bw = slot * 0.58 %>
          <% @daily.each_with_index do |b, i| %>
            <% c = b["cost"] || 0; h = (c / d_max) * 150.0; x = (i * slot) + ((slot - bw) / 2.0) %>
            <% tokens = %w[input_tokens output_tokens].sum { |k| b[k].to_i } %>
            <rect class="bar<%== ' bar-empty' if c.zero? %>" x="<%= format('%.1f', x) %>" y="<%= format('%.1f', c.zero? ? 157.0 : 160.0 - h) %>"
                  width="<%= format('%.1f', bw) %>" height="<%= format('%.1f', c.zero? ? 3.0 : [h, 3.0].max) %>" rx="2">
              <title><%= Time.iso8601(b["at"]).utc.strftime('%b %-d') %> · <%= usd(c) %> · <%= b["requests"] %> requests · <%= tokens %> tokens</title>
            </rect>
          <% end %>
          <line class="barchart-axis-line" x1="0" y1="160" x2="700" y2="160" />
        </svg>
        <div class="barchart-axis">
          <span><%= Time.iso8601(@daily.first["at"]).utc.strftime('%b %-d') %></span>
          <span class="peak"><%= usd(d_costs.sum) %> in 14 days · peak <%= usd(d_max) %>/day</span>
          <span><%= Time.iso8601(@daily.last["at"]).utc.strftime('%b %-d') %></span>
        </div>
      <% end %>
    </section>

    <section class="card">
      <div class="section-head"><h2>Waiting for a reply</h2><span class="muted">customer spoke last, 10+ min ago · 24h</span></div>
      <% if @stalled.empty? %>
        <div class="empty">No conversation is waiting.</div>
      <% else %>
        <table class="grid">
          <thead><tr><th>conversation</th><th>agent</th><th class="num">waiting</th></tr></thead>
          <tbody>
            <% @stalled.each do |row| %>
              <tr><td><a class="mono" href="/studio/sessions/<%= Rack::Utils.escape(row[:id]) %>" title="<%= row[:id] %>"><%= row[:id][0, 20] %></a></td>
                <td><%= row[:agent].empty? ? "—" : row[:agent] %></td><td class="num"><%= time_ago(row[:waiting].iso8601) %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  </div>

  <div class="home-grid">
    <section class="card">
      <div class="section-head"><h2>Agents</h2><span class="muted">conversations · last 14 days</span></div>
      <% if @agent_ranking.empty? %>
        <div class="empty">No agent conversations yet.</div>
      <% else %>
        <table class="grid">
          <thead><tr><th>agent</th><th class="num">today</th><th class="num">14 days</th><th class="num">messages</th></tr></thead>
          <tbody>
            <% @agent_ranking.each do |row| %>
              <tr><td><a href="/studio/chats?agent=<%= Rack::Utils.escape(row[:agent]) %>"><%= row[:agent] %></a></td>
                <td class="num"><%= row[:today] %></td><td class="num"><%= row[:conversations] %></td><td class="num"><%= row[:messages] %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
      <% unless @cold_agents.empty? %>
        <p class="muted">No conversation in <%= COLD_AGENT_DAYS %>+ days: <%== @cold_agents.map { |id| %(<a href="/studio/agents/#{Rack::Utils.escape(id)}">#{Rack::Utils.escape_html(id)}</a>) }.join(", ") %></p>
      <% end %>
    </section>

    <section class="card">
      <div class="section-head"><h2>Tool health</h2><span class="muted">last 24h</span></div>
      <% tools = turns ? turns["tools"].sort_by { |t| [-t["failures"], -t["calls"]] }.first(8) : [] %>
      <% if tools.empty? %>
        <div class="empty">No tool calls in the last 24h.</div>
      <% else %>
        <table class="grid">
          <thead><tr><th>tool</th><th class="num">calls</th><th class="num">ok %</th><th class="num">p95 ms</th></tr></thead>
          <tbody>
            <% tools.each do |t| %>
              <tr><td><%= t["tool"] %></td><td class="num"><%= t["calls"] %></td>
                <td class="num"><%= format("%.1f", (t["calls"] - t["failures"]) * 100.0 / t["calls"]) %></td>
                <td class="num"><%= t["p95_ms"] || "—" %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  </div>
  </turbo-frame>
</div>
