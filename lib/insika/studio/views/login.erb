<div class="card auth-card">
  <div class="brand big"><span class="dot"></span>Insika <small>Studio</small></div>
  <p class="muted lead">Sign in with your operator token to manage your agents.</p>

  <% if @error %>
    <div class="flash err" role="alert"><%= @error %></div>
  <% end %>

  <form method="post" action="/studio/login">
    <%== csrf_tag %>
    <label>Operator token
      <input type="password" name="token" autocomplete="current-password" autofocus
             placeholder="ADMIN_TOKEN">
    </label>
    <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Signing in…">Sign in</button></div>
  </form>
</div>
