<header class="page-head harvest-head">
  <div>
    <%== crumbs_for("Harvest") %>
    <h1>Harvest<span class="sub">Turn conversation evidence into reusable skills</span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/harvest", @agent) %>
  </div>
</header>

<% if insika[:harvest_store].nil? %>
  <div class="empty">No harvest — the store is not wired.</div>
<% elsif @agents.empty? %>
  <div class="empty">No agents yet. Add a <span class="mono">harvest:</span> block to an agent's pack to mine its finished traffic.</div>
<% else %>
  <div class="card">
    <h2>Find new skills</h2>
    <form method="post" action="/studio/harvest" class="actions">
      <%== csrf_tag %>
      <label>
        Agent
        <select name="agent">
          <% @agents.each do |id| %>
            <option value="<%= id %>"<%== ' selected' if id == @agent %>><%= id %></option>
          <% end %>
        </select>
      </label>
      <label class="check" title="Ignore the mined markers and re-read the whole window (the ledger dedup still protects).">
        <input type="checkbox" name="full" value="1"> Re-read full window
      </label>
      <button type="submit" class="primary" data-turbo-submits-with="Mining…">Mine now</button>
    </form>
    <div class="skill-desc muted">
      Reviews finished conversations and proposes skills. Nothing is applied until the evidence checks pass and you approve it.
    </div>
  </div>

  <% if @candidates.empty? && @blocked.empty? && @pending_gates.empty? %>
    <div class="empty">No skills awaiting review. Mine finished conversations to find candidates.</div>
  <% end %>

  <%# The human's inbox. %>
  <% if @candidates.any? %>
    <h2>Awaiting approval<span class="sub">review evidence before applying</span></h2>
    <% @candidates.each do |cand| %>
      <div class="card harvest-candidate">
        <div class="review-heading"><div><h3><%= cand.name %></h3><p class="muted"><%= cand.description %></p></div><span class="pill warn">Awaiting approval</span></div>
        <section class="harvest-proposal">
          <h3>Proposed skill</h3>
          <p class="muted"><%= cand.rationale %></p>
          <div class="markdown-preview" data-controller="markdown"><%= cand.body %></div>
        </section>
        <details class="review-details"><summary>Evaluation results</summary>
        <div class="skill-desc">
          <span class="status <%= status_class(cand.status) %>">gated</span>
          <span class="mono"><%= cand.name %></span>
          <span class="muted">· <%= cand.description %></span>
        </div>
        <% Array(cand.triggers).each do |t| %>
          <span class="pill"><%= t %></span>
        <% end %>
        <div class="skill-desc muted">
          store <span class="mono"><%= cand.agent %></span> · proposed by
          <span class="mono"><%= cand.proposer %></span> · <%= (cand.eval_gate || {})["passed_cases"] %>/<%= (cand.eval_gate || {})["cases"] %> case(s) no regression
          · conversion <%= (cand.conversion_gate || {})["current"] %> vs <%= (cand.conversion_gate || {})["baseline"] %> (threshold <%= (cand.conversion_gate || {})["threshold"] %>)
        </div>
        </details>
        <% if (excerpt = candidate_excerpt(cand)).any? %>
          <details class="review-details" open>
            <summary>Conversation evidence</summary>
            <% excerpt.each do |sid, idx, text| %>
              <div class="harvest-evidence">
                <a class="mono" href="/studio/sessions/<%= Rack::Utils.escape(sid) %>">Open conversation ↗</a>
                <p class="review-source"><%= text %></p>
              </div>
            <% end %>
          </details>
        <% end %>
        <details class="review-details"><summary>Source conversations</summary>
        <% Array(cand.origin).each do |sid| %>
          <a class="mono muted" href="/studio/sessions/<%= Rack::Utils.escape(sid) %>"><%= sid %></a>
        <% end %>
        </details>
        <form method="post" action="/studio/harvest/promote" class="actions">
          <%== csrf_tag %>
          <input type="hidden" name="agent" value="<%= cand.agent %>">
          <input type="hidden" name="candidate_id" value="<%= cand.id %>">
          <label>
            Note
            <input type="text" name="note" placeholder="why (optional)">
          </label>
          <button type="submit" class="primary" data-turbo-submits-with="Promoting…">Promote</button>
          <button type="submit" class="ghost" formaction="/studio/harvest/reject">Reject</button>
        </form>
        <div class="skill-desc muted">
          Promoting saves and enables this skill for the agent. The previous state is saved so you can roll it back.
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Gated-but-blocked: the ruler's hole, named. %>
  <% if @blocked.any? %>
    <h2>Blocked<span class="sub">resolve these before approval</span></h2>
    <div class="card">
      <ul class="history">
        <% @blocked.each do |cand| %>
          <li>
            <span class="status <%= status_class('blocked') %>">blocked</span>
            <span class="mono"><%= cand.name %></span>
            <span class="preview muted">
              <% reason = (cand.conversion_gate || {})["reason"] %>
              <% if reason == "no_frozen_baseline" %>
                the store has no frozen funnel baseline — freeze it first on the
                <a href="/studio/funnel">Funnel page</a>
              <% elsif reason %>
                <%= reason %>
              <% else %>
                <%= (cand.eval_gate || {})["reason"] %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Mined, not yet gated. %>
  <% if @pending_gates.any? %>
    <h2>Pending<span class="sub">awaiting evaluation and conversion checks</span></h2>
    <div class="card">
      <ul class="history">
        <% @pending_gates.each do |cand| %>
          <li>
            <span class="status <%= status_class(cand.status) %>"><%= cand.status %></span>
            <span class="mono"><%= cand.name %></span>
            <span class="preview muted"><%= cand.description %></span>
            <form method="post" action="/studio/harvest/gate" class="actions inline">
              <%== csrf_tag %>
              <input type="hidden" name="agent" value="<%= cand.agent %>">
              <input type="hidden" name="candidate_id" value="<%= cand.id %>">
              <button type="submit" class="primary" data-turbo-submits-with="Checking…">Run checks</button>
              <button type="submit" class="ghost" formaction="/studio/harvest/reject">Reject</button>
            </form>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The promotion log — the single ledger, with the rollback mirror. %>
  <% if @promotions.any? %>
    <h2>Promoted<span class="sub">promotion history</span></h2>
    <div class="card">
      <ul class="history">
        <% @promotions.each do |row| %>
          <li>
            <% if row.rolled_back_at %>
              <span class="status <%= status_class('rejected') %>">rolled back</span>
            <% else %>
              <span class="status <%= status_class('approved') %>">promoted</span>
            <% end %>
            <span class="mono"><%= row.skill %></span>
            <span class="preview muted">
              <%= row.approver %> · <%= row.at %>
              <% if row.rolled_back_at %>· rolled back <%= row.rolled_back_at %><% end %>
            </span>
            <% unless row.rolled_back_at %>
              <form method="post" action="/studio/harvest/rollback" class="actions inline">
                <%== csrf_tag %>
                <input type="hidden" name="agent" value="<%= row.agent %>">
                <input type="hidden" name="snapshot_ref" value="<%= row.snapshot_ref %>">
                <label>Rollback reason <input type="text" name="reason" placeholder="Optional"></label>
                <button type="submit" class="ghost">Rollback</button>
              </form>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# The negative list block. %>
  <% if @negative && @negative.rules.any? %>
    <details class="review-details"><summary>Negative list rules</summary>
    <h2>Negative list<span class="sub">rules that exclude candidates</span></h2>
    <div class="card">
      <ul class="history">
        <% @negative.rules.each do |rule| %>
          <li>
            <span class="pill"><%= rule.rule %></span>
            <span class="preview muted"><%= rule.pattern %><%= " — #{rule.note}" if presence(rule.note) %></span>
            <span class="preview muted">rejected: <%= negative_rule_counts[rule.rule] || 0 %></span>
          </li>
        <% end %>
      </ul>
      <div class="skill-desc muted">
        The list is pack data on the profile (hot-editable); the versioned
        rules file seeds it via
        <span class="mono">insika harvest:negative import --agent ID --file F</span>.
      </div>
    </div>
    </details>
  <% end %>

  <%# The ruler block. %>
  <% if @criterion %>
    <h2>Conversion criterion<span class="sub">frozen before the first promotion</span></h2>
    <div class="card">
      <div class="skill-desc">
        <span class="pill">metric <%= @criterion.rule.metric %></span>
        <span class="pill">window <%= @criterion.rule.window %></span>
        <span class="pill">not worse than <%= @criterion.rule.threshold %></span>
        <span class="mono muted"><%= @criterion.sha %></span>
      </div>
      <div class="skill-desc muted">
        The ruler is the frozen criterion file, read-only here; the
        store's frozen baseline lives on the <a href="/studio/funnel">Funnel page</a>. A
        store without one can mine, but the gate parks its candidates.
      </div>
    </div>
  <% end %>

  <% if @runs.any? %>
    <h2>Runs<span class="sub">most recent first</span></h2>
    <div class="card table-scroll" tabindex="0" role="region" aria-label="Harvest runs">
      <table class="grid">
        <thead>
          <tr><th>status</th><th>run</th><th class="num">candidates</th><th class="num">tokens</th><th class="time">started</th></tr>
        </thead>
        <tbody>
          <% @runs.each do |run| %>
            <tr>
              <td><span class="status <%= status_class(run.status) %>"><%= run.status %></span></td>
              <td class="mono"><%= run.id[0, 12] %></td>
              <td class="num"><%= run.candidates %></td>
              <td class="num"><%= run.cost && run.cost["spent"].to_i.positive? ? run.cost["spent"] : "—" %></td>
              <td class="time"><%= run.started_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
