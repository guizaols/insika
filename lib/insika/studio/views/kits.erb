<%# Kits — drill-down: master list | kit editor + membership. A kit bundles
   skills, tools and MCP servers; agents that list it (AgentProfile#kits) get
   them at read time (Insika::Kits). @selected nil = none open, "" = new. %>
<header class="page-head">
  <h1>Kits<span class="sub">Bundles of skills and tools that agents share</span></h1>
</header>
<div class="drill" data-controller="list-filter">
  <aside class="drill-pane drill-master">
    <div class="drill-pane-head">
      <div class="title"><strong>Kits <span class="count"><%= @kits.size %></span></strong></div>
      <a class="btn primary btn-sm" href="/studio/kits/new">+ new</a>
    </div>
    <div class="drill-search">
      <input type="search" class="filter-input" placeholder="Search kits…" aria-label="Filter kits"
             data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
    </div>
    <nav class="drill-pane-body drill-list" aria-label="kits">
      <% if @kits.empty? %>
        <div class="empty">No kits yet. Create one to share skills and tools across agents.</div>
      <% end %>
      <% @kits.each do |name, kit| %>
        <% members = @agents.count { |a| Array(a.kits).include?(name) } %>
        <a class="drill-item<%== ' active' if @selected == name %>"
           href="/studio/kits/<%= Rack::Utils.escape(name) %>"
           data-list-filter-target="item" data-filter-text="<%= name %> <%= kit["description"] %>">
          <div class="drill-item-name"><span class="txt" title="<%= name %>"><%= name %></span><span class="pill plain"><%= members %> <%= members == 1 ? "agent" : "agents" %></span></div>
          <div class="drill-item-sub"><%= kit["description"] %></div>
        </a>
      <% end %>
      <div class="empty" data-list-filter-target="empty" hidden>No kits match your filter.</div>
    </nav>
  </aside>

  <section class="drill-pane drill-detail">
    <% if @selected.nil? %>
      <div class="drill-empty">
        <div>
          <h2>Kits</h2>
          <p>Pick a kit, or create one. A kit bundles skills and tools; every agent in it gets them on its next turn.</p>
        </div>
      </div>
    <% else %>
      <% new = @selected == "" %>
      <% kit = @kit || {} %>
      <div class="drill-pane-head">
        <div class="title"><strong class="mono"><%= new ? "New kit" : @selected %></strong></div>
        <button type="submit" form="kit-form" class="btn primary" data-turbo-submits-with="Saving…">Save kit</button>
      </div>
      <div class="drill-pane-body">
        <form id="kit-form" method="post" action="/studio/kits" data-controller="dirty-guard">
          <%== csrf_tag %>
          <% if new %>
            <label>name <span class="muted">(lowercase slug, e.g. grocery)</span>
              <input type="text" name="name" placeholder="grocery" required pattern="[a-z0-9][a-z0-9_\-]{0,63}">
            </label>
          <% else %>
            <input type="hidden" name="name" value="<%= @selected %>">
          <% end %>
          <label>description
            <input type="text" name="description" value="<%= kit["description"] %>" placeholder="What agents in this kit have in common">
          </label>

          <details class="tool-section" open>
            <summary>Skills <span class="count"><%= Array(kit["skills"]).size %>/<%= @skills.size %></span></summary>
            <div class="check-grid tool-grid">
              <% @skills.each do |s| %>
                <label class="check tool-check" title="<%= s.description %>">
                  <input type="checkbox" name="skills[]" value="<%= s.name %>"<%== " checked" if Array(kit["skills"]).include?(s.name) %>>
                  <span class="mono"><%= s.name %></span>
                </label>
              <% end %>
            </div>
          </details>

          <% if @tool_group_names.any? %>
            <details class="tool-section" open>
              <summary>MCP servers <span class="count"><%= Array(kit["tool_groups"]).size %>/<%= @tool_group_names.size %></span></summary>
              <div class="check-grid tool-grid">
                <% @tool_group_names.each do |g| %>
                  <label class="check tool-check">
                    <input type="checkbox" name="tool_groups[]" value="<%= g %>"<%== " checked" if Array(kit["tool_groups"]).include?(g) %>>
                    <span class="mono">all tools from <%= g.delete_prefix("mcp:") %></span>
                  </label>
                <% end %>
              </div>
            </details>
          <% end %>

          <div class="only-on-scope" data-controller="list-filter">
            <details class="tool-section" open>
              <summary>Tools <span class="count"><%= Array(kit["tools"]).size %>/<%= @tools.size %></span></summary>
              <div class="matrix-topline">
                <label class="switch" title="hide tools not in this kit; typing a search shows every match">
                  <input type="checkbox" id="only-on" checked>
                  <span class="switch-track" aria-hidden="true"></span>
                  <span class="switch-label">only in kit</span>
                </label>
              </div>
              <input type="search" class="filter-input" placeholder="Search to add tools…" aria-label="Search tools"
                     data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
              <p class="empty" data-list-filter-target="empty" hidden>No tools match your filter.</p>
              <div class="check-grid tool-grid">
                <% @tools.each do |t| %>
                  <label class="check tool-check" title="<%= t.description %>"
                         data-list-filter-target="item" data-filter-text="<%= t.name %>">
                    <input type="checkbox" name="tools[]" value="<%= t.name %>"<%== " checked" if Array(kit["tools"]).include?(t.name) %>>
                    <span class="mono"><%= t.name %></span>
                  </label>
                <% end %>
              </div>
            </details>
          </div>
        </form>

        <% unless new %>
          <div class="drill-section">
            <div class="drill-section-head">
              <h3>Agents</h3>
              <span class="muted">Checked agents get this kit's skills and tools on their next turn. An agent allowed every tool or every skill keeps that.</span>
            </div>
            <form method="post" action="/studio/kits/<%= Rack::Utils.escape(@selected) %>/agents" data-controller="dirty-guard">
              <%== csrf_tag %>
              <% if @agents.empty? %>
                <p class="muted">No agents configured.</p>
              <% else %>
                <div class="check-grid tool-grid">
                  <% @agents.each do |a| %>
                    <label class="check tool-check">
                      <input type="checkbox" name="agent_ids[]" value="<%= a.id %>"<%== " checked" if Array(a.kits).include?(@selected) %>>
                      <span class="mono"><%= a.id %></span>
                    </label>
                  <% end %>
                </div>
                <div class="actions"><button type="submit" class="primary" data-turbo-submits-with="Applying…">Apply to agents</button></div>
              <% end %>
            </form>
          </div>

          <div class="drill-section">
            <form method="post" action="/studio/kits/<%= Rack::Utils.escape(@selected) %>/delete">
              <%== csrf_tag %>
              <div class="actions"><button type="submit" data-turbo-confirm="Remove kit? Agents in it lose its skills and tools.">Delete kit</button></div>
            </form>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
