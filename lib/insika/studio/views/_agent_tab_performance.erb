<!-- ── Performance ───────────────────────────────────────────────────────── -->
<% q = Rack::Utils.escape(@agent.id) %>
<section class="section" id="performance" data-tabs-target="panel">
  <div class="section-head">
    <h2>Performance</h2>
    <p class="muted">The same numbers as the <a href="/studio/home?agent=<%= q %>" data-turbo-frame="_top">home</a> and <a href="/studio/models?agent=<%= q %>" data-turbo-frame="_top">Models</a>, for this agent. Latency is the whole turn; first balloon is what a channel customer waits.</p>
  </div>
  <%# loading="lazy": the frame fetches when the tab is first shown. %>
  <turbo-frame id="agent-performance" src="/studio/agents/<%= q %>/performance" loading="lazy">
    <div class="card"><p class="muted">Loading…</p></div>
  </turbo-frame>
</section>
