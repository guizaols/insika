<%# the Follow-ups page — the Board shell: a KPI strip that opens the page
   (pending/fired/cancelled/blocked, scoped to whatever the agent filter
   currently shows) followed by one ledger + A/B card per declaring agent.
   Reads the FollowupStore/ContactStore/OutcomeStore directly (D10); the
   ONLY mutations — cancel a pending record, force-revoke a contact —
   dispatch bus commands. Nothing here is engine vocabulary: the arm names,
   the reasons and the policy values are the pack's (D1/D8). %>
<header class="page-head operation-head">
  <div>
    <%== crumbs_for("Follow-ups") %>
    <h1>Follow-ups<span class="sub">Review scheduled messages and delivery history</span></h1>
  </div>
  <div class="head-actions">
    <%== agent_filter_form("/studio/followups", @agent) %>
  </div>
</header>

<% all_records = @stores.flat_map { |s| s[:records] } %>
<div class="kpi-strip">
  <%== render("_kpi", locals: { label: "Pending", value: all_records.count { |r| r.status == "pending" } }) %>
  <%== render("_kpi", locals: { label: "Fired", value: all_records.count { |r| r.status == "fired" } }) %>
  <%== render("_kpi", locals: { label: "Cancelled", value: all_records.count { |r| r.status == "cancelled" } }) %>
  <%== render("_kpi", locals: { label: "Blocked", value: all_records.count { |r| r.status == "blocked" } }) %>
</div>

<% if !@has_followups %>
  <%== render("_empty", locals: { icon: :followups,
    text: "No follow-ups — add a followup: block to an agent's pack and the records it schedules land here." }) %>
<% else %>
  <div class="operation-followups" data-controller="list-filter">
    <div class="filter-bar">
      <input type="search" class="filter-input" placeholder="Filter by customer, reason or status…" aria-label="Filter follow-ups"
             data-list-filter-target="query" data-action="input->list-filter#filter keydown->list-filter#clear">
      <span class="filter-count mono muted" data-list-filter-target="count"></span>
    </div>
  <% @stores.each do |store| %>
    <% profile, policy, records = store[:profile], store[:policy], store[:records] %>
    <h2><a href="<%= agent_path(profile.id) %>"><%= profile.id %></a><span class="sub"><%= records.count { |r| r.status == "pending" } %> pending · <%= records.size %> records</span></h2>

    <div class="card operation-table">
      <div class="section-head">
        <h3>Schedule records</h3>
      </div>

      <% if records.empty? %>
        <div class="empty">No follow-up records for this agent yet — the <span class="mono">schedule</span> tool writes them.</div>
      <% else %>
        <table class="grid">
          <thead>
            <tr>
              <th>Customer</th><th>Scheduled for</th><th>Reason</th><th>Arm</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% records.each do |r| %>
              <tr data-list-filter-target="item" data-filter-text="<%= profile.id %> <%= r.customer %> <%= r.reason %> <%= r.arm %> <%= r.status %> <%= r.blocked_reason %>">
                <td class="mono"><%= r.customer %><% if presence(r.session_id) %><br><a href="/studio/sessions/<%= Rack::Utils.escape(r.session_id) %>">Conversation ↗</a><% end %></td>
                <td class="mono"><%= r.at %></td>
                <td><%= r.reason %></td>
                <td><span class="status info"><%= r.arm %></span></td>
                <td>
                  <% if r.status == "blocked" %>
                    <span class="status <%= status_class(r.status) %>">blocked · <%= r.blocked_reason %></span>
                  <% else %>
                    <span class="status <%= status_class(r.status) %>"><%= r.status %></span>
                  <% end %>
                </td>
                <td class="row-actions">
                  <% if r.status == "pending" %>
                    <form method="post" action="/studio/followups/<%= Rack::Utils.escape(profile.id) %>/cancel" class="actions">
                      <%== csrf_tag %>
                      <input type="hidden" name="id" value="<%= r.id %>">
                      <button type="submit" class="btn ghost btn-sm danger">Cancel</button>
                    </form>
                    <form method="post" action="/studio/followups/<%= Rack::Utils.escape(profile.id) %>/revoke" class="actions">
                      <%== csrf_tag %>
                      <input type="hidden" name="customer" value="<%= r.customer %>">
                      <input type="hidden" name="tenant" value="<%= r.tenant %>">
                      <button type="submit" class="btn ghost btn-sm danger" title="A channel opt-out event that never arrived — revokes the contact and cancels its pending follow-ups">Revoke contact</button>
                    </form>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <details class="operation-diagnostics">
        <summary>Follow-up policy</summary>
        <p class="muted">Arm <strong><%= policy.arm %></strong> · silence after <%= policy.silence_after_sends %> send(s). <a href="<%= agent_path(profile.id, "config", "cfg=followups") %>">Edit policy ↗</a></p>
        <% qh = policy.quiet_hours %>
        <p class="skill-desc">
          <span class="status info"><%= qh ? "quiet #{qh.start}-#{qh.end} <#{qh.timezone}>" : "no quiet hours" %></span>
          <span class="status info"><%= policy.max_frequency ? "max #{policy.max_frequency}" : "no frequency ceiling" %></span>
          <span class="muted"><%= policy.cancel_keywords.empty? ? "no cancellation keywords" : "keywords: #{policy.cancel_keywords.join(' · ')}" %></span>
        </p>
      </details>
    </div>

    <%# D3: the A/B card — a READ-ONLY fold over the same records. The
        ruler outside the card is the operator's baseline; this card only
        reads it (the note says so). A regression spec matches the
        conversion-% and opt-outs cells' text content ("…100.0%…1…") to
        prove the opt-out count is arm-scoped, never a global revoked
        count — it doesn't pin the exact opening-tag markup. %>
    <div class="card operation-table">
      <div class="section-head">
        <h3>A/B readout <span class="muted">last 30 days · per arm</span></h3>
        <span class="muted">the A/B is the operator's — the card reads the baseline</span>
      </div>
      <% if store[:ab].empty? %>
        <div class="empty">Nothing fired in the period — the readout appears when the engine fires.</div>
      <% else %>
        <table class="grid">
          <thead>
            <tr><th>arm</th><th class="num">sent</th><th class="num">conversions</th><th class="num">conversion %</th><th>opt-outs</th></tr>
          </thead>
          <tbody>
            <% store[:ab].each do |arm, row| %>
              <tr>
                <td><span class="status info"><%= arm %></span></td>
                <td class="num tnum"><%= row[:sent] %></td>
                <td class="num tnum"><%= row[:conversions] %></td>
                <td class="num tnum"><%= row[:sent].zero? ? "—" : format("%.1f", row[:conversions].to_f / row[:sent] * 100) %>%</td>
                <td class="num tnum"><%= row[:opt_outs] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
    <div class="empty" data-list-filter-target="empty" hidden>No follow-ups match your filter.</div>
  </div>
<% end %>
