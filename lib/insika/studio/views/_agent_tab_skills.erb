<!-- ── Agent skills ──────────────────────────────────────────────────────── -->
<section class="section" id="skills" data-tabs-target="panel">
  <div class="section-head">
    <h2>Skills</h2>
    <p class="muted">Choose which catalog skills this agent may load. Save skills applies this selection to <strong><%= @agent.id %></strong>.</p>
  </div>
  <form class="card" method="post" action="/studio/agents/<%= Rack::Utils.escape(@agent.id) %>/skills" data-controller="toggle-counter dirty-guard">
    <%== csrf_tag %>
    <div class="matrix-topline">
      <% if @all_skills.empty? %>
        <span class="muted">No skills in the catalog yet — create one under <a href="/studio/skills/new" data-turbo-frame="_top">skills → new</a>.</span>
      <% else %>
        <span class="count-badge mono" data-toggle-counter-target="count"><%= @agent_skills.nil? ? "all" : "#{@agent_skills.size}/#{@all_skills.size} on" %></span>
        <label class="switch" title="open allowlist — every catalog skill flows through">
          <input type="checkbox" name="all_skills" value="1"<%== " checked" if @agent_skills.nil? %>
                 data-toggle-counter-target="all" data-action="change->toggle-counter#update">
          <span class="switch-track" aria-hidden="true"></span>
          <span class="switch-label">all skills</span>
        </label>
      <% end %>
    </div>
    <% kit_skills = @agent_skills.nil? ? {} : kit_sources(@agent, "skills") %>
    <% if Array(@agent.kits).any? %>
      <% kit_links = @agent.kits.map { |k| %(<a class="pill info" href="/studio/kits/#{Rack::Utils.escape(k)}" data-turbo-frame="_top">#{h(k)}</a>) }.join(" ") %>
      <% if @agent_skills.nil? %>
        <p class="muted">Its kits <%== kit_links %> add nothing here: this agent already gets every skill. Turn off <strong>all skills</strong> to limit it to its own list plus its kits.</p>
      <% else %>
        <p class="muted">Skills marked <span class="pill info">kit</span> come from its kits <%== kit_links %> and are edited there.</p>
      <% end %>
    <% end %>
    <% unless @all_skills.empty? %>
      <div class="check-grid tool-grid" data-toggle-counter-target="grid">
        <% @all_skills.sort_by(&:name).each do |s| %>
          <% from_kit = !@agent_skills.nil? && !@agent_skills.include?(s.name) && kit_skills[s.name] %>
          <label class="check tool-check"<%== %( title="from kit #{h(from_kit)}") if from_kit %>>
            <input type="checkbox" name="skills[]" value="<%= s.name %>"<%== " checked" if @agent_skills&.include?(s.name) || from_kit %><%== " disabled" if from_kit %>
                   data-toggle-counter-target="tool" data-locked="<%= !!from_kit %>" data-action="change->toggle-counter#update">
            <span class="mono"><%= s.name %></span><% if from_kit %> <span class="pill info">kit</span><% end %>
          </label>
        <% end %>
      </div>
    <% end %>
    <div class="actions">
      <button type="submit" class="primary" data-turbo-submits-with="Saving…">Save skills</button>
      <a class="btn ghost" href="/studio/tools" data-turbo-frame="_top">Edit tools</a>
    </div>
  </form>
</section>
