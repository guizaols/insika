<!-- ── History ───────────────────────────────────────────────────────────── -->
<section class="section" id="history" data-tabs-target="panel">
  <div class="section-head">
    <h2>What changed, and what it did</h2>
    <p class="muted"><%= @change_primary ? "Primary outcome · #{@change_primary}" : "All outcomes" %> per day, last <%= @change_days.size %> days. A dashed line marks each prompt-file change.</p>
  </div>
  <div class="card">
    <% max = [@change_days.values.max || 0, 1].max; span = @change_days.size * 86_400.0 %>
    <svg class="barchart" viewBox="0 0 700 176" preserveAspectRatio="none" role="img" aria-label="outcomes per day, last <%= @change_days.size %> days, with prompt-file changes">
      <% slot = 700.0 / @change_days.size; bw = slot * 0.58 %>
      <% @change_days.each_with_index do |(d, c), i| %>
        <% h = (c.to_f / max) * 150.0; x = (i * slot) + ((slot - bw) / 2.0) %>
        <rect class="bar<%== ' bar-empty' if c.zero? %>" x="<%= format('%.1f', x) %>" y="<%= format('%.1f', c.zero? ? 157.0 : 160.0 - h) %>"
              width="<%= format('%.1f', bw) %>" height="<%= format('%.1f', c.zero? ? 3.0 : [h, 3.0].max) %>" rx="2">
          <title><%= d.strftime('%b %-d') %> · <%= c %> outcome<%= 's' unless c == 1 %></title>
        </rect>
      <% end %>
      <% @changes.each do |ch| %>
        <% x = format('%.1f', (ch[:at] - @change_start) / span * 700.0) %>
        <line class="change-mark" x1="<%= x %>" y1="0" x2="<%= x %>" y2="160" vector-effect="non-scaling-stroke"><title><%= ch[:file] %> · <%= ch[:at].strftime('%b %-d %H:%M UTC') %></title></line>
      <% end %>
      <line class="barchart-axis-line" x1="0" y1="160" x2="700" y2="160" />
    </svg>
    <div class="barchart-axis"><span><%= @change_days.keys.first.strftime('%b %-d') %></span><span>today</span></div>
  </div>
  <% if @changes.empty? %>
    <div class="empty">No prompt-file changes in the last <%= @change_days.size %> days.</div>
  <% end %>
  <% @changes.each do |ch| %>
    <div class="card">
      <div class="drill-section-head">
        <h3><%= ch[:file] %></h3>
        <span class="muted mono"><%= ch[:at].strftime('%Y-%m-%d %H:%M UTC') %></span>
      </div>
      <% unless ch[:removed].empty? && ch[:added].empty? %>
        <pre class="diff"><% ch[:removed].first(6).each do |l| %><span class="del">- <%= l %></span><% end %><% ch[:added].first(6).each do |l| %><span class="ins">+ <%= l %></span><% end %></pre>
      <% end %>
      <p>
        <% if ch[:before] && ch[:after] %>
          Outcomes: <strong class="tnum"><%= ch[:after] %></strong> in the 7 days after vs <strong class="tnum"><%= ch[:before] %></strong> in the 7 days before.
        <% else %>
          <span class="muted">Outcomes 7 days after vs 7 days before: not enough data.</span>
        <% end %>
      </p>
      <form method="post" action="/studio/agents/<%= Rack::Utils.escape(@agent.id) %>/prompts/restore">
        <%== csrf_tag %>
        <input type="hidden" name="file" value="<%= ch[:file] %>">
        <input type="hidden" name="version" value="<%= ch[:version] %>">
        <button type="submit" class="ghost">Restore the version before</button>
      </form>
    </div>
  <% end %>

  <div class="section-head">
    <h2>History</h2>
    <p class="muted">This agent's most recent conversations. Every conversation is in <a href="/studio/chats?agent=<%= Rack::Utils.escape(@agent.id) %>" data-turbo-frame="_top">Chats</a>.</p>
  </div>
  <% if @recent_sessions.empty? %>
    <div class="empty">No conversations yet. Start one in the <a href="/studio/playground?agent=<%= Rack::Utils.escape(@agent.id) %>" data-turbo-frame="_top">playground</a>.</div>
  <% else %>
    <div class="card">
      <ul class="history">
        <% @recent_sessions.each do |s| %>
          <li>
            <a href="/studio/sessions/<%= Rack::Utils.escape(s.id) %>" data-turbo-frame="_top">
              <span class="mono"><%= s.id[0, 12] %></span>
            </a>
            <span class="muted"><%= Array(s.messages).size %> msg · <%= s.updated_at %></span>
            <% if (p = session_preview(s)) %><span class="preview muted"><%= p[0, 80] %></span><% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
