.DS_Store
*.db
*.sqlite3
*.gem
tmp/
.bundle/
vendor/bundle/
# Studio (Phase 4): node_modules NOT checked in; assets/dist/ IS (D8 — `ruby
# serve` runs without Node; only front-end editors need npm install + build).
node_modules/
*.db-shm
*.db-wal
*.db-journal
.playwright-mcp/*
# Local secrets (sourced by scripts/loadtest-local.sh; NUNCA versionar chaves)
.env
.env.local
.env.*.local
# Eval run artifacts (evals/run.rb --out); keep the dir, not the outputs
evals/reports/*.json
# Deployment-specific eval material (real-store baselines/goldens) — never shipped
evals/internal/
# A captured baseline is per-deployment data (evals/run.rb --update-baseline)
evals/baseline.json

# Docs site (docs/ is the Jekyll site root). `docs/llms.txt` is a build-time COPY of
# the repo-root llms.txt, staged by .github/workflows/pages.yml — never commit it.
docs/_site/
docs/.jekyll-cache/
docs/llms.txt

# Internal working material — kept locally, NOT tracked/shipped in the OSS repo
# (internal RFCs, design docs, handoff bundle, planning docs, pilot benchmarks/scripts).
docs/README.md
docs/FOLLOWUP.md
docs/TRANSLATION-TRACKER.md
docs/HANDOFF-TECHSPEC.md
docs/harness_handoff/
docs/techspec/
docs/internal/
docs/harness-handoff.zip
scripts/internal/

# spec/scripts/ was a blanket ignore, which hid specs for PUBLIC
# scripts (bin/insika, scripts/bench.rb) from CI along with the one spec that
# is genuinely internal — openclaw_to_manifest_spec.rb requires_relative a file
# under scripts/internal/, which does not exist in this checkout. Ignore the
# directory's contents by default, track the ones that guard public surface.
spec/scripts/*
!spec/scripts/insika_cli_spec.rb
!spec/scripts/bench_spec.rb
!spec/scripts/loadtest_session_spec.rb
!spec/scripts/replay_compaction_spec.rb
!spec/scripts/migrate_openclaw_spec.rb
