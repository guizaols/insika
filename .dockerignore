# Lean build context: leave out everything that doesn't go into the image.
.git
.github
.claude
.ruby-lsp
node_modules
**/node_modules
studio/assets/src
spec
docs
tmp
log
*.log

# Local databases/sidecars (the volume mounts INSIKA_DB at runtime)
*.db
*.db-shm
*.db-wal

.DS_Store
.env
.env.*
scratchpad
