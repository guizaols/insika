# Lean build context: leave out everything that doesn't go into the image.
.git
.github
.claude
.ruby-lsp
node_modules
**/node_modules
lib/insika/studio/assets/src
lib/insika/studio/test
spec
tmp
# docs/ ships: the onboarding surface reads docs/onboarding/start.md, docs/prompts
# and docs/*.md at runtime (GET /start.md, /docs/<name>.md). Only the Jekyll
# build output and the internal notes stay out.
docs/_site
docs/.jekyll-cache
docs/internal
docs/harness_handoff
docs/techspec
log
*.log

# Local databases/sidecars (the volume mounts INSIKA_DB at runtime)
*.db
*.db-shm
*.db-wal

.DS_Store
.env
.env.*
scratchpad
