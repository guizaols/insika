.github
.claude
.ruby-lsp
node_modules
**/node_modules
lib/insika/studio/assets/src
lib/insika/studio/test
spec
docs
tmp
log
*.log

# Local databases/sidecars (the volume mounts INSIKA_DB at runtime)
*.db
*.db-shm
*.db-wal

.DS_Store
.env
.env.*
scratchpad
